@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ECRS</title>

    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet"> *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">



    @RenderSection("Styles", required: false)

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            min-height: 100vh;
            background: #eef1ef;
            color: #222;
            display: flex;
            flex-direction: column;
        }

        a {
            text-decoration: none;
        }

        .ecrs-header,
        .ecrs-sidebar,
        .ecrs-footer,
        .ecrs-sidebar-top {
            background: darkgreen;
            color: #fff;
        }

            .ecrs-header a,
            .ecrs-sidebar a,
            .ecrs-footer a {
                color: #fff;
            }

        .ecrs-header {
            min-height: 72px;
            padding: 14px 18px;
        }

        .ecrs-brand {
            min-width: 0;
        }

        /*  .login-logo {
                    width: 64px;
                    height: 52px;
                    flex: 0 0 64px;
                    background: url('/FDA_Logo.png') center/contain no-repeat;
                } */

        .ecrs-brand-title {
            font-size: 20px;
            line-height: 1.2;
            white-space: nowrap;
        }

        .ecrs-header-right {
            flex: 0 0 auto;
            white-space: nowrap;
        }

        .ecrs-shell {
            flex: 1 0 auto;
            display: flex;
            min-height: 0;
            width: 100%;
        }

        .ecrs-layout {
            display: flex;
            width: 100%;
            min-height: 0;
            align-items: stretch;
        }

        .ecrs-sidebar-top {
            padding: 8px 10px 0;
        }

        .ecrs-sidebar {
            /*width: 270px;*/
            /*min-width: 270px;*/
            width: auto;
            min-height: 100%;
            border-right: 1px solid rgba(255,255,255,.15);
            padding: 0px;
        }

            .ecrs-sidebar.collapsed {
                display: none;
            }

        .auth-box {
            font-size: 12px;
            color: floralwhite;
            margin-bottom: 10px;
        }

        .ecrs-menu,
        .ecrs-submenu {
            list-style: none;
        }

        .ecrs-menu {
            margin: 0;
            padding: 10px 8px;
            background: rgba(255,255,255,.12);
            border-radius: 8px;
        }

            .ecrs-menu > li {
                margin-bottom: 6px;
            }

                .ecrs-menu > li > a,
                .ecrs-submenu > li > a {
                    display: block;
                    border-radius: 6px;
                    color: #fff !important;
                }

                .ecrs-menu > li > a {
                    padding: 11px 14px;
                }

                /* 改成琴鍵式分層後補上的CSS */
                .ecrs-menu > li > .menu-toggle,
                .ecrs-submenu > li > a {
                    display: block;
                    width: 100%;
                    border-radius: 6px;
                    color: #fff !important;
                }

                .ecrs-menu > li > .menu-toggle {
                    padding: 11px 14px;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                }

                    .ecrs-menu > li > .menu-toggle:hover,
                    .ecrs-menu > li > .menu-toggle:focus,
                    .ecrs-menu > li.active > .menu-toggle {
                        background: rgba(255,255,255,.18) !important;
                        color: #fff !important;
                    }

        .menu-toggle .bi {
            transition: transform .25s ease;
        }

        .menu-toggle[aria-expanded="true"] .bi {
            transform: rotate(180deg);
        }
        /* 改成琴鍵式分層後補上的CSS ---END*/


        .ecrs-submenu {
            margin: 8px 0 0;
            padding: 6px 0 0 12px;
            border-left: 2px solid rgba(255,255,255,.18);
        }

            .ecrs-submenu > li > a {
                padding: 10px 12px;
                margin: 6px 10px 6px 0;
                color: rgba(255,255,255,.92) !important;
            }

                .ecrs-menu > li > a:hover,
                .ecrs-menu > li > a:focus,
                .ecrs-menu > li.active > a,
                .ecrs-submenu > li > a:hover,
                .ecrs-submenu > li > a:focus,
                .ecrs-submenu > li.active > a {
                    background: rgba(255,255,255,.18) !important;
                    color: #fff !important;
                }

        .ecrs-main {
            min-width: 0;
            flex: 1 1 auto;
            background: rgba(255,255,255,.9);
            padding: 16px;
            overflow-x: auto;
        }

        .ecrs-mobile-bar {
            display: none;
            padding-bottom: 10px;
        }

        .offcanvas .ecrs-sidebar {
            padding-top: 12px;
            height: 100%;
        }

        .ecrs-footer {
            min-height: 60px;
            padding: 8px 16px;
            font-size: 10pt;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            line-height: 1.6;
            flex-shrink: 0;
        }



        /* logo */
        .login-logo {
            width: 98px;
            height: 58px;
            background: url('/FDA_Logo.png');
            background-repeat: no-repeat;
            background-size: contain; /* 或 cover */
            background-position: center;
            display: flex;
            align-items: center;
        }

        .login-wrapper {
            display: flex;
            align-items: center; /* 垂直置中 */
            gap: 10px; /* 兩個區塊間距 */
        }

        /* menu 收合 展開 鍵 */
        .wrapper {
            min-height: 100vh;
        }

        .content {
            width: 100%;
        }

        /* menu 縮小 收合 展開 鍵 */
        .btn-xxs {
            padding: 2px 6px;
            font-size: 12px;
            line-height: 1;
        }

        /* 預設顯示「收合內容」, 隱藏 展開全部 */
        .when-collapsed {
            display: none;
        }

        /* 展開時顯示「收合內容」 */
        button:not(.collapsed) .when-collapsed {
            display: none;
        }

        button:not(.collapsed) .when-expanded {
            display: inline;
        }

        /* 收合時顯示「展開全部」 */
        button.collapsed .when-collapsed {
            display: inline;
        }

        button.collapsed .when-expanded {
            display: none;
        }



        /* 箭頭動畫 */
        .arrow-icon {
            display: inline-block;
            transition: transform 0.3s ease;
        }



        /* 展開時旋轉 180 度 */
        button:not(.collapsed) .arrow-icon {
            transform: rotate(180deg);
        }


        @@media (max-width: 991.98px) {
            .ecrs-header {
                min-height: auto;
                padding: 12px 14px;
            }

            .ecrs-brand-title {
                white-space: normal;
            }

            .ecrs-shell {
                flex: 1 0 auto;
                min-height: 0;
            }

            .ecrs-mobile-bar {
                display: block;
            }
        }




        
    </style>    
    
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var _PReviewControl = currentController == "InspectionByPReview";

        var isInspection = currentController == "Inspection";
        var isInspectionWork = isInspection && currentAction == "InspectionQry";
        var isInspectionVendor = isInspection && currentAction == "Fquery";
        var isInspectionCase = isInspection && currentAction == "FormQuery";
        // var isInspectionPReview = isInspection && currentAction == "PReview";
        var isInspectionPReview = _PReviewControl && currentAction == "PReview";


        var isFormManage = currentController == "FormManage";
        var isFormManageFormEditer = isFormManage && currentAction == "FormEditer";
        var isFormManageFormQryByPJ = isFormManage && currentAction == "FormQryByPJ";

        var token = HttpContextAccessor.HttpContext?.Session.GetString("AuthToken");
        var displayName = HttpContextAccessor.HttpContext?.Session.GetString("DisplayName");

        //如果選中待審核案件，兩個Menu頭要縮合
        if (!isInspectionPReview && currentAction == "PReview")
        {
            //把參數指定為False
            isInspection = false;
            isFormManage = false;
        }
    }

    <header class="ecrs-header">
        <div class="d-flex flex-wrap align-items-center gap-3 gap-lg-4 w-100">

            <div class="ecrs-brand d-flex align-items-center gap-3">
                <div class="login-logo"></div>
                <a class="ecrs-brand-title text-white" asp-controller="Inspection" asp-action="Index">ECRS-稽查系統</a>
            </div>

            <div class="ecrs-header-right d-flex align-items-center gap-3 ms-auto">
                <a class="text-white d-inline-flex align-items-center" asp-controller="Inspection" asp-action="Index" title="回首頁">
                    <i class="bi bi-house-door-fill"></i>
                </a>

                @if (!string.IsNullOrWhiteSpace(token))
                {
                    <span class="d-inline-flex align-items-center text-white small">Hi, @displayName</span>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light btn-sm">登出</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-outline-light btn-sm" asp-controller="Auth" asp-action="Login">登入</a>
                }
            </div>
        </div>
    </header>

    <div class="ecrs-shell">
        <div class="ecrs-layout w-100">
            <aside id="sidebar" class="col-3 ecrs-sidebar">

                <div class="d-none d-md-block">
                    <div class="auth-box">
                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <div>已登入 @User.Identity!.Name</div>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm w-100" asp-controller="Auth" asp-action="Login">登入</a>
                        }

                    </div>

                    <ul id="sidebaru" class="nav nav-pills d-none d-md-block ecrs-menu flex-column">
                        <li class="@(isInspection ? "active" : "")">
                            <button type="button"
                                    class="menu-toggle w-100 text-start border-0 bg-transparent"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#inspectionMenu"
                                    aria-expanded="@(isInspection ? "true" : "false")"
                                    aria-controls="inspectionMenu">
                                <span>稽查管理</span>
                                <i class="bi bi-chevron-down ms-auto"></i>
                            </button>

                            <div id="inspectionMenu" class="collapse @(isInspection ? "show" : "")" data-bs-parent="#sidebaru">
                                <ul class="ecrs-submenu">
                                    <li class="@(isInspectionWork ? "active" : "")">
                                        <a asp-controller="Inspection" asp-action="InspectionQry">稽查作業</a>
                                    </li>
                                    <li class="@(isInspectionVendor ? "active" : "")">
                                        <a asp-controller="Inspection" asp-action="Fquery">業者稽查查詢</a>
                                    </li>
                                    <li class="@(isInspectionCase ? "active" : "")">
                                        <a asp-controller="Inspection" asp-action="FormQuery">稽查單查詢</a>
                                    </li>
                                </ul>
                            </div>
                        </li>

                        <li class="@(isInspectionPReview ? "active" : "")">
                            <a asp-controller="Inspection" asp-action="PReview">待審核案件</a>
                        </li>

                        <li class="@(isFormManage ? "active" : "")">
                            <button type="button"
                                    class="menu-toggle w-100 text-start border-0 bg-transparent"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#FormManageMenu"
                                    aria-expanded="@(isFormManage ? "true" : "false")"
                                    aria-controls="FormManageMenu">
                                <span>表單管理</span>
                                <i class="bi bi-chevron-down ms-auto"></i>
                            </button>

                            <div id="FormManageMenu" class="collapse @(isFormManage ? "show" : "")" data-bs-parent="#sidebaru">
                                <ul class="ecrs-submenu">
                                    <li class="@(isFormManageFormEditer ? "active" : "")">
                                        <a asp-controller="FormManage" asp-action="FormEditer">表單編輯作業</a>
                                    </li>
                                    <li class="@(isFormManageFormQryByPJ ? "active" : "")">
                                        <a asp-controller="FormManage" asp-action="FormQryByPJ">專案查詢</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                       
                    </ul>
                </div>
            </aside>

            <main class="col-9 ecrs-main" id="mainContent">
                <div style="font-size:smaller">

                    <!-- 桌機收合按鈕 -->
                    <button id="toggleSidebar"
                            class="btn btn-xxs btn-light d-none d-lg-inline d-md-inline" aria-label="切換選單">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                </div>

                <div class="content flex-grow-1">

                    <!-- 手機版 Header -->
                    <nav class="navbar navbar-light bg-light px-3 d-md-none" style="height:30px">
                        <button class="btn btn-xxs btn-outline-secondary d-md-none"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#mobileSidebar">
                            ☰
                        </button>

                    </nav>
                </div>

                @RenderBody()
            </main>
        </div>

        <!-- ===== 手機 Offcanvas ===== -->
        <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
            <aside class="col-12 ecrs-sidebar" style="width:100%">
                <ul id="sidebarum" class="offcanvas-body p-0 nav nav-pills flex-column"></ul>
            </aside>
        </div>
    </div>

    <footer class="ecrs-footer">
        <div>
            建議使用 Edge或Chrome版本之瀏覽器，螢幕解析度1024X768以上瀏覽 衛生福利部食品藥物管理署 ©2022-2030 版權所有​<br />
            諮詢服務專線 : 0809-091-133 諮詢服務時間 : 08:00~12:00及13:00~18:00 (周一至周五)
        </div>
    </footer>


    @*版本太舊，已不適用*@
    @* <script src="~/lib/jquery/dist/jquery.min.js"></script> *@

    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.7/css/dataTables.bootstrap5.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.7/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.7/js/dataTables.bootstrap5.min.js"></script>


    <script>
        const sidebar = document.getElementById("sidebar");
        const toggleBtn = document.getElementById("toggleSidebar");
        const icon = toggleBtn?.querySelector("i");
        const mainContent = document.getElementById("mainContent");
        const sidebarMenu = document.getElementById("sidebaru");

        // ===== 手機 Offcanvas 複製選單 =====
        const mobileSidebar = document.querySelector("#mobileSidebar .offcanvas-body");
        if (mobileSidebar) {
        //alert(sidebaru.innerHTML);
            mobileSidebar.innerHTML = sidebaru.innerHTML;
        }

        function setSidebarState(collapsed) {
            if (!sidebar || !mainContent) return;

            sidebar.classList.toggle("collapsed", collapsed);
            if (icon) {
                icon.classList.toggle("bi-chevron-right", collapsed);
                icon.classList.toggle("bi-chevron-left", !collapsed);
            }
            localStorage.setItem("sidebarCollapsed", collapsed ? "true" : "false");
        }

        const savedCollapsed = localStorage.getItem("sidebarCollapsed") === "true";
        setSidebarState(savedCollapsed);

        toggleBtn?.addEventListener("click", function () {
            const collapsed = !sidebar.classList.contains("collapsed");
            setSidebarState(collapsed);
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
