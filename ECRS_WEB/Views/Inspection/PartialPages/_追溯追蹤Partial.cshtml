<script>
    (function () {
        function bindConditionalCategory(triggerId, categorySelector, categoryInputId) {
            var trigger = document.getElementById(triggerId);
            var category = document.querySelector(categorySelector);
            var categoryInput = document.getElementById(categoryInputId);

            if (!trigger || !category) {
                return;
            }

            function syncCategory() {
                var shouldShow = trigger.checked;
                category.classList.toggle('is-visible', shouldShow);

                if (!shouldShow && categoryInput) {
                    categoryInput.checked = false;
                }
            }

            trigger.addEventListener('change', syncCategory);
            syncCategory();
        }

        bindConditionalCategory('traceBusinessImport', '.trace-import-category', 'traceCategoryImportedPlantProduct');
        bindConditionalCategory('traceBusinessManufacture', '.trace-manufacture-category', 'traceCategoryOtherFoodBusiness');
        bindConditionalCategory('traceBusinessSell', '.trace-sell-category', 'traceCategorySellBoxMeal');

        function isRadioYes(name) {
            var checkedRadio = document.querySelector('input[name="' + name + '"]:checked');
            return checkedRadio && checkedRadio.value === 'Y';
        }

        function clearFields(container) {
            if (!container) {
                return;
            }

            container.querySelectorAll('input[type="radio"], input[type="checkbox"]').forEach(function (input) {
                input.checked = false;
            });

            container.querySelectorAll('input[type="text"], textarea').forEach(function (input) {
                input.value = '';
            });
        }

        function setRowVisible(row, shouldShow) {
            if (!row) {
                return;
            }

            row.classList.toggle('is-visible', shouldShow);

            if (!shouldShow) {
                clearFields(row);
            }
        }

        function setPanelVisible(panel, shouldShow) {
            if (!panel) {
                return;
            }

            panel.classList.toggle('is-visible', shouldShow);

            if (!shouldShow) {
                clearFields(panel);
            }
        }

        function bindRadioChange(name, sync) {
            document.querySelectorAll('input[name="' + name + '"]').forEach(function (radio) {
                radio.addEventListener('change', sync);
            });
        }

        var systemComplianceRow = document.getElementById('traceSystemComplianceRow');
        var systemNonconformingRow = document.getElementById('traceSystemNonconformingRow');
        var invoiceOpenedRow = document.getElementById('traceInvoiceOpenedRow');
        var invoiceNonconformingRow = document.getElementById('traceInvoiceNonconformingRow');
        var gmoLabelRow = document.getElementById('traceGmoLabelRow');
        var nonGmoClaimRow = document.getElementById('traceNonGmoClaimRow');
        var electronicReportComplianceRow = document.getElementById('traceElectronicReportComplianceRow');
        var electronicReportNonconformingRow = document.getElementById('traceElectronicReportNonconformingRow');
        var electronicReportPanel = document.getElementById('traceElectronicReportPanel');

        function syncTraceSystemRows() {
            var shouldShowCompliance = isRadioYes('traceSystemRequired');
            setRowVisible(systemComplianceRow, shouldShowCompliance);
            setRowVisible(systemNonconformingRow, shouldShowCompliance && !isRadioYes('traceSystemCompliance') && document.querySelector('input[name="traceSystemCompliance"]:checked') !== null);
        }

        function syncInvoiceRows() {
            var shouldShowOpened = isRadioYes('traceInvoiceRequired');
            setRowVisible(invoiceOpenedRow, shouldShowOpened);
            setRowVisible(invoiceNonconformingRow, shouldShowOpened && !isRadioYes('traceInvoiceOpened') && document.querySelector('input[name="traceInvoiceOpened"]:checked') !== null);
        }

        function syncElectronicReportRows() {
            var shouldShowCompliance = isRadioYes('traceElectronicReportRequired');
            var complianceChecked = document.querySelector('input[name="traceElectronicReportCompliance"]:checked') !== null;
            var complianceNo = shouldShowCompliance && complianceChecked && !isRadioYes('traceElectronicReportCompliance');

            setRowVisible(electronicReportComplianceRow, shouldShowCompliance);
            setRowVisible(electronicReportNonconformingRow, complianceNo);
            setPanelVisible(electronicReportPanel, shouldShowCompliance && complianceChecked);
        }

        bindRadioChange('traceSystemRequired', syncTraceSystemRows);
        bindRadioChange('traceSystemCompliance', syncTraceSystemRows);
        bindRadioChange('traceInvoiceRequired', syncInvoiceRows);
        bindRadioChange('traceInvoiceOpened', syncInvoiceRows);
        bindRadioChange('traceGmoLabelRequired', function () {
            setRowVisible(gmoLabelRow, isRadioYes('traceGmoLabelRequired'));
        });
        bindRadioChange('traceNonGmoClaim', function () {
            setRowVisible(nonGmoClaimRow, isRadioYes('traceNonGmoClaim'));
        });
        bindRadioChange('traceElectronicReportRequired', syncElectronicReportRows);
        bindRadioChange('traceElectronicReportCompliance', syncElectronicReportRows);

        syncTraceSystemRows();
        syncInvoiceRows();
        setRowVisible(gmoLabelRow, isRadioYes('traceGmoLabelRequired'));
        setRowVisible(nonGmoClaimRow, isRadioYes('traceNonGmoClaim'));
        syncElectronicReportRows();
    })();
</script>
