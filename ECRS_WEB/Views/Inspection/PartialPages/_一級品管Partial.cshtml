<style>
    .qc-yesno-table .trace-yesno-row {
        grid-template-columns: 400px minmax(0, 1fr);
    }

    .qc-yesno-table .trace-yesno-label {
        justify-content: flex-start;
        padding-left: 24px;
        padding-right: 12px;
        text-align: left;
        white-space: nowrap;
    }

    .qc-manufacture-category,
    .qc-import-category {
        display: none;
    }

    .qc-manufacture-category.is-visible,
    .qc-import-category.is-visible {
        display: inline-flex;
    }

    .qc-conditional-row {
        display: none;
    }

    .qc-conditional-row.is-visible {
        display: grid;
    }
</style>

<script>
    (function () {
        function bindConditionalCategories(triggerId, categorySelector) {
            var trigger = document.getElementById(triggerId);
            var categories = document.querySelectorAll(categorySelector);

            if (!trigger || categories.length === 0) {
                return;
            }

            function syncCategories() {
                categories.forEach(function (category) {
                    category.classList.toggle('is-visible', trigger.checked);

                    if (!trigger.checked) {
                        var input = category.querySelector('input[type="checkbox"]');

                        if (input) {
                            input.checked = false;
                        }
                    }
                });
            }

            trigger.addEventListener('change', syncCategories);
            syncCategories();
        }

        bindConditionalCategories('qcBusinessManufacture', '.qc-manufacture-category');
        bindConditionalCategories('qcBusinessImport', '.qc-import-category');

        function getCheckedRadioValue(name) {
            var checked = document.querySelector('input[name="' + name + '"]:checked');
            return checked ? checked.value : '';
        }

        function clearRadioRows(rows) {
            rows.forEach(function (row) {
                if (!row) {
                    return;
                }

                row.querySelectorAll('input[type="radio"]').forEach(function (radio) {
                    radio.checked = false;
                });
            });
        }

        function setRadioRowVisible(row, shouldShow) {
            if (!row) {
                return;
            }

            row.classList.toggle('is-visible', shouldShow);

            if (!shouldShow) {
                clearRadioRows([row]);
            }
        }

        function bindRadioChange(name, sync) {
            document.querySelectorAll('input[name="' + name + '"]').forEach(function (radio) {
                radio.addEventListener('change', sync);
            });
        }

        var mandatoryComplianceRow = document.getElementById('qcMandatoryComplianceRow');
        var mandatoryNonComplianceRow = document.getElementById('qcMandatoryNonComplianceRow');

        function syncMandatoryInspectionRows() {
            var shouldShowCompliance = getCheckedRadioValue('qcMandatoryInspection') === 'Y';

            setRadioRowVisible(mandatoryComplianceRow, shouldShowCompliance);

            if (!shouldShowCompliance) {
                setRadioRowVisible(mandatoryNonComplianceRow, false);
                return;
            }

            setRadioRowVisible(
                mandatoryNonComplianceRow,
                getCheckedRadioValue('qcMandatoryCompliance') === 'N'
            );
        }

        bindRadioChange('qcMandatoryInspection', syncMandatoryInspectionRows);
        bindRadioChange('qcMandatoryCompliance', syncMandatoryInspectionRows);
        syncMandatoryInspectionRows();
    })();
</script>
