@{
    // ViewData["Title"] = "稽查管理-稽查單查詢內容";
    ViewData["Title"] = "稽查管理 - 稽查作業 - 表單：餐飲業 食品良好衛生規範準則 稽查記錄表";
}

@section Styles {
    <style>
        .div-result {
            border: 1px solid #9fbea4;
            height: 120px;
            margin: 16px 0 16px 0;
        }

        .span-title-l2 {
            color: forestgreen;
        }

        .inspect-tab-wrap {
            width: 100%;
            margin: 16px 0;
        }

        .inspect-tab-header {
            display: flex;
            width: 100%;
            border: 1px solid #9fbea4;
            border-radius: 12px 12px 0 0;
            overflow: hidden;
            background: linear-gradient(to bottom, #eef7ef 0%, #dcebdd 100%);
        }

        .inspect-tab-btn {
            position: relative;
            flex: 1;
            height: 46px;
            border: 0;
            background: linear-gradient(to bottom, #eef7ef 0%, #dcebdd 100%);
            color: #6f9674;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s ease;
            border-right: 1px solid #b9d0bc;
        }

            .inspect-tab-btn:last-child {
                border-right: none;
            }

            /* 被選擇的 Tag */
            .inspect-tab-btn.active {
                color: #ffffff;
                background: linear-gradient(to bottom, #006400 0%, #005400 100%);
                box-shadow: inset 0 -2px 0 rgba(255,255,255,.12);
            }

                /* 底下小三角 */
                .inspect-tab-btn.active::after {
                    content: "";
                    position: absolute;
                    left: 50%;
                    bottom: -1px;
                    transform: translateX(-50%);
                    width: 0;
                    height: 0;
                    border-left: 10px solid transparent;
                    border-right: 10px solid transparent;
                    border-top: 10px solid #005400;
                }

            /* 未被選擇的 hover */
            .inspect-tab-btn:not(.active):hover {
                background: linear-gradient(to bottom, #e4f1e6 0%, #d2e4d4 100%);
                color: #4f7f56;
            }

        .inspect-tab-panel {
            display: none;
        }

            .inspect-tab-panel.active {
                display: block;
            }


        .photo-upload-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 18px;
        }

        .photo-upload-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            height: 46px;
            padding: 0 18px;
            /* border: 2px solid #9fd3d8; */
            border: 2px solid forestgreen;
            border-radius: 999px;
            background: linear-gradient(to bottom, #f9ffff 0%, #edf8f9 100%);
            /* color: #3aa8b3; */
            color: forestgreen;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s ease;
        }

            .photo-upload-pill:hover {
                background: linear-gradient(to bottom, #eefbfc 0%, #e2f3f5 100%);
                border-color: #86c4cb;
                color: #2f97a2;
            }

        .photo-upload-pill-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            font-size: 15px;
            color: forestgreen;
        }

        .photo-upload-section {
            margin-bottom: 20px;
        }

        .photo-upload-title {
            font-size: 16px;
            font-weight: 700;
            color: green;
            margin-bottom: 8px;
        }


        .inspection-file-list {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 12px;
            align-items: flex-start;
        }

        .inspection-file-chip {
            display: flex;
            align-items: center;
            min-width: 320px;
            max-width: 460px;
            height: 48px;
            border: 1px solid #d7e0e3;
            border-radius: 8px;
            overflow: hidden;
        }

        .inspection-file-title {
            flex: 0 0 100%;
            margin: 0 0 8px 0;
            color: forestgreen;
        }

        .attach-tab-wrap {
            background: #eef7ef;
            padding: 10px 0 12px 0;
        }

        .attach-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            padding: 0 12px 10px 12px;
        }

        .attach-pill-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            height: 42px;
            padding: 0 18px;
            /* border: 2px solid #71c1cc; */
            border: 2px solid forestgreen;
            border-radius: 999px;
            background: linear-gradient(to bottom, #fbffff 0%, #edf7f8 100%);
            /* color: #39a7b3; */
            color: forestgreen;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s ease;
        }

            .attach-pill-btn:hover {
                /* background: linear-gradient(to bottom, #f0fbfc 0%, #e2f2f4 100%); */
                background: linear-gradient(to bottom, #F0FFF0 0%, #CEFFCE 100%);
                color: forestgreen;
                border-color: forestgreen;
            }

        .attach-pill-icon {
            font-size: 14px;
            color: forestgreen;
        }

        .attach-section-card {
            margin: 0 12px 12px 12px;
            background: #fff;
            border: 1px solid #b8d1d7;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 1px 3px rgba(0,0,0,.05);
        }

        .attach-section-title {
            padding: 10px 14px;
            font-size: 18px;
            font-weight: 700;
            color: #5b5b5b;
            border-bottom: 1px solid #e3ecef;
            background: #fff;
        }

        .attach-file-row {
            display: flex;
            flex-wrap: wrap;
            gap: 18px;
            padding: 14px;
        }

        .attach-file-item {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .attach-file-main {
            display: flex;
            align-items: center;
            min-width: 170px;
        }

        .attach-file-icon {
            width: 40px;
            height: 48px;
            border-radius: 4px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 800;
            color: #fff;
            flex-shrink: 0;
            margin-right: 10px;
            box-shadow: 0 1px 2px rgba(0,0,0,.12);
        }

            .attach-file-icon.pdf {
                background: #d92c2c;
            }

            .attach-file-icon.word {
                background: #2b66c0;
            }

            .attach-file-icon.excel {
                background: #1f8a49;
            }

            .attach-file-icon.img {
                background: #2f855a;
            }

        .attach-file-meta {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .attach-file-name {
            font-size: 16px;
            font-weight: 700;
            color: #66b7c0;
            line-height: 1.2;
        }

        .attach-file-size {
            font-size: 14px;
            color: #b4b4b4;
        }

        .attach-file-remove {
            width: 34px;
            height: 34px;
            border: 1px solid #dbdbdb;
            border-radius: 50%;
            background: #f9f9f9;
            color: #9c9c9c;
            font-size: 24px;
            line-height: 1;
            cursor: pointer;
            padding: 0;
        }

            .attach-file-remove:hover {
                background: #f1f1f1;
                color: #6f6f6f;
            }

        .attach-save-row {
            display: flex;
            justify-content: flex-end;
            padding: 0 14px 14px 14px;
        }

        .attach-save-btn {
            min-width: 92px;
            height: 40px;
            border: 0;
            border-radius: 24px;
            /* background: linear-gradient(to bottom, #19a6b3 0%, #0d93a2 100%); */
            background: linear-gradient(to bottom, forestgreen 0%, darkgreen 100%);
            color: #fff;
            font-size: 16px;
            font-weight: 700;
            box-shadow: 0 2px 4px rgba(0,0,0,.12);
        }

            .attach-save-btn:hover {
                /* background: linear-gradient(to bottom, #1597a3 0%, #0a8592 100%); */
                background: linear-gradient(to bottom, #00EC00 0%, forestgreen 100%);
            }

        @@media (max-width: 992px) {
            .attach-file-row {
                gap: 12px;
            }

            .attach-file-item {
                width: 100%;
                justify-content: space-between;
            }
        }

        .photo-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.45);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 3000;
        }

            .photo-modal-overlay.show {
                display: flex;
            }

        .photo-modal {
            width: 92%;
            max-width: 720px;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 12px 30px rgba(0,0,0,.2);
            overflow: hidden;
            animation: photoModalIn .2s ease;
        }

        @@keyframes photoModalIn {
            from {
                opacity: 0;
                transform: translateY(10px) scale(.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .photo-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            background: linear-gradient(to bottom, forestgreen 0%, darkgreen 100%);
            color: #fff;
        }

        .photo-modal-title {
            font-size: 20px;
            font-weight: 700;
            margin: 0;
        }

        .photo-modal-close {
            width: 38px;
            height: 38px;
            border: 0;
            border-radius: 50%;
            background: rgba(255,255,255,.15);
            color: #fff;
            font-size: 24px;
            line-height: 1;
            cursor: pointer;
        }

            .photo-modal-close:hover {
                background: rgba(255,255,255,.25);
            }

        .photo-modal-body {
            padding: 20px;
        }

        .photo-modal-upload-row {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }

        .photo-modal-select-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 140px;
            height: 42px;
            padding: 0 18px;
            border: 2px solid forestgreen;
            border-radius: 999px;
            background: #fff;
            color: forestgreen;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
        }

            .photo-modal-select-btn:hover {
                background: #f3fff3;
            }

        .photo-modal-tip {
            color: #666;
            font-size: 14px;
        }

        .photo-thumb-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            min-height: 120px;
        }

        .photo-thumb-item {
            width: 120px;
        }

        .photo-thumb-box {
            width: 120px;
            height: 120px;
            border: 1px solid #cfd8cf;
            border-radius: 12px;
            overflow: hidden;
            background: #f6f6f6;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .photo-thumb-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .photo-thumb-name {
            margin-top: 8px;
            font-size: 13px;
            color: #333;
            word-break: break-all;
            line-height: 1.4;
        }

        .photo-thumb-remove {
            margin-top: 6px;
            width: 100%;
            height: 32px;
            border: 1px solid #d8d8d8;
            border-radius: 999px;
            background: #fff;
            color: #666;
            font-size: 13px;
            cursor: pointer;
        }

            .photo-thumb-remove:hover {
                background: #f5f5f5;
            }

        .photo-empty-tip {
            color: #999;
            font-size: 14px;
            padding: 16px 0;
        }

        .photo-modal-footer {
            display: flex;
            justify-content: flex-end;
            margin-top: 24px;
        }

        .photo-modal-submit-btn {
            min-width: 110px;
            height: 42px;
            padding: 0 24px;
            border: 0;
            border-radius: 8px;
            background: forestgreen;
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
        }

            .photo-modal-submit-btn:hover {
                background: darkgreen;
            }

    </style>
}


<h1 class="main-title">
    <span id="ctl00_ContentPlaceHolder1_UC_NodeName_lblNodeName">@ViewData["Title"]</span>
</h1>

<!-- 上方切換頁籤 -->
<div class="inspect-tab-wrap">
    <div class="inspect-tab-header">
        <button type="button" class="inspect-tab-btn active" data-tab="tab-result">
            稽查結果
        </button>
        <button type="button" class="inspect-tab-btn" data-tab="tab-photo">
            照片
        </button>
        <button type="button" class="inspect-tab-btn" data-tab="tab-attach">
            附件
        </button>
    </div>

    <div class="inspect-tab-body">
        <!-- 稽查結果 -->
        <div id="tab-result" class="inspect-tab-panel active">
            <div class="p-3">
                @* 這裡放「稽查結果」內容 *@
                <h4>
                    <span class="span-title-l2">GHP稽查項目</span>
                </h4>
                <div class="div-result">
                </div>

                <h4>
                    <span class="span-title-l2">HACCP稽查項目</span>
                </h4>
                <div class="div-result">
                </div>

                <h4>
                    <span class="span-title-l2">抽驗單</span>
                </h4>
                <div class="div-result">
                </div>
            </div>
        </div>
        <!-- 照片 -->
        <div id="tab-photo" class="inspect-tab-panel">
            <div class="p-3">

                <div class="photo-upload-toolbar">
                    <button type="button" class="photo-upload-pill"
                            onclick="openPhotoModal('缺失/違規照片', 'photoViolationInput', 'photoViolationList')">
                        <span class="photo-upload-pill-icon">⇪</span>
                        <span>缺失/違規照片</span>
                    </button>

                    <button type="button" class="photo-upload-pill"
                            onclick="openPhotoModal('稽查背心照片', 'photoVestInput', 'photoVestList')">
                        <span class="photo-upload-pill-icon">⇪</span>
                        <span>稽查背心照片</span>
                    </button>

                    <button type="button" class="photo-upload-pill"
                            onclick="openPhotoModal('抽驗產品照片', 'photoSampleInput', 'photoSampleList')">
                        <span class="photo-upload-pill-icon">⇪</span>
                        <span>抽驗產品照片</span>
                    </button>

                    <button type="button" class="photo-upload-pill"
                            onclick="openPhotoModal('其他', 'photoOtherInput', 'photoOtherList')">
                        <span class="photo-upload-pill-icon">⇪</span>
                        <span>其他</span>
                    </button>
                </div>

                <!-- 隱藏的 input -->
                <input type="file" id="photoViolationInput" class="d-none" multiple accept="image/*" onchange="handlePhotoFiles(this)" />
                <input type="file" id="photoVestInput" class="d-none" multiple accept="image/*" onchange="handlePhotoFiles(this)" />
                <input type="file" id="photoSampleInput" class="d-none" multiple accept="image/*" onchange="handlePhotoFiles(this)" />
                <input type="file" id="photoOtherInput" class="d-none" multiple accept="image/*" onchange="handlePhotoFiles(this)" />

                <!-- 各類照片清單 -->
                <div class="photo-upload-section">
                    <div class="photo-upload-title">缺失/違規照片</div>
                    <div class="inspection-file-list" id="photoViolationList"></div>
                </div>

                <div class="photo-upload-section">
                    <div class="photo-upload-title">稽查背心照片</div>
                    <div class="inspection-file-list" id="photoVestList"></div>
                </div>

                <div class="photo-upload-section">
                    <div class="photo-upload-title">抽驗產品照片</div>
                    <div class="inspection-file-list" id="photoSampleList"></div>
                </div>

                <div class="photo-upload-section">
                    <div class="photo-upload-title">其他</div>
                    <div class="inspection-file-list" id="photoOtherList"></div>
                </div>

            </div>
        </div>

        <div id="photoUploadModal" class="photo-modal-overlay" onclick="closePhotoModalByOverlay(event)">
            <div class="photo-modal" onclick="event.stopPropagation()">
                <div class="photo-modal-header">
                    <h3 id="photoModalTitle" class="photo-modal-title">照片上傳</h3>
                    <button type="button" class="photo-modal-close" onclick="closePhotoModal()">×</button>
                </div>

                <div class="photo-modal-body">
                    <div class="photo-modal-upload-row">
                        <button type="button" class="photo-modal-select-btn" onclick="choosePhotoFile()">
                            選擇照片
                        </button>
                        <span class="photo-modal-tip">照片單張不得超過 2MB，最多 3 張，上傳檔案格式(JPG、PNG)</span>
                    </div>

                    <div id="photoModalPreview" class="photo-thumb-grid"></div>

                    <div class="photo-modal-footer">
                        <button type="button" class="photo-modal-submit-btn" onclick="closePhotoModal()">
                            上傳
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 附件 -->

        <div id="attachUploadModal" class="photo-modal-overlay" onclick="closeAttachModalByOverlay(event)">
            <div class="photo-modal" onclick="event.stopPropagation()">
                <div class="photo-modal-header">
                    <h3 id="attachModalTitle" class="photo-modal-title">附件上傳</h3>
                    <button type="button" class="photo-modal-close" onclick="closeAttachModal()">×</button>
                </div>

                <div class="photo-modal-body">
                    <div class="photo-modal-upload-row">
                        <button type="button" class="photo-modal-select-btn" onclick="chooseAttachFile()">
                            選擇附件
                        </button>
                        <span class="photo-modal-tip">
                            附件檔案限制上傳檔案格式(Word、Excel、PDF、ODS、JPG、PNG)，限制容量為每份10MB為限且不可超過3份
                        </span>
                    </div>

                    <div id="attachModalPreview" class="attach-file-row"></div>

                    <div class="photo-modal-footer">
                        <button type="button" class="photo-modal-submit-btn" onclick="closeAttachModal()">
                            上傳
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-attach" class="inspect-tab-panel">
            <div class="attach-tab-wrap">

                <!-- 上方分類上傳按鈕 -->
                <div class="attach-toolbar">
                    <button type="button" class="attach-pill-btn"
                            onclick="openAttachModal('談話紀錄', 'attachTalkInput', 'attachTalkList')">
                        <span class="attach-pill-icon">⇪</span>
                        <span>談話紀錄</span>
                    </button>

                    <button type="button" class="attach-pill-btn"
                            onclick="openAttachModal('相關事證', 'attachEvidenceInput', 'attachEvidenceList')">
                        <span class="attach-pill-icon">⇪</span>
                        <span>相關事證</span>
                    </button>

                    <button type="button" class="attach-pill-btn"
                            onclick="openAttachModal('查扣物品', 'attachSeizedInput', 'attachSeizedList')">
                        <span class="attach-pill-icon">⇪</span>
                        <span>查扣物品</span>
                    </button>

                    <button type="button" class="attach-pill-btn"
                            onclick="openAttachModal('其他', 'attachOtherInput', 'attachOtherList')">
                        <span class="attach-pill-icon">⇪</span>
                        <span>其他</span>
                    </button>
                </div>

                <!-- 隱藏 input -->
                <input type="file" id="attachTalkInput" class="d-none" multiple
                       accept=".doc,.docx,.xls,.xlsx,.pdf,.ods,.jpg,.jpeg,.png"
                       onchange="handleAttachFiles(this)" />

                <input type="file" id="attachEvidenceInput" class="d-none" multiple
                       accept=".doc,.docx,.xls,.xlsx,.pdf,.ods,.jpg,.jpeg,.png"
                       onchange="handleAttachFiles(this)" />

                <input type="file" id="attachSeizedInput" class="d-none" multiple
                       accept=".doc,.docx,.xls,.xlsx,.pdf,.ods,.jpg,.jpeg,.png"
                       onchange="handleAttachFiles(this)" />

                <input type="file" id="attachOtherInput" class="d-none" multiple
                       accept=".doc,.docx,.xls,.xlsx,.pdf,.ods,.jpg,.jpeg,.png"
                       onchange="handleAttachFiles(this)" />

                <!-- 談話紀錄 -->
                <div class="attach-section-card">
                    <div class="attach-section-title">談話紀錄</div>
                    <div class="attach-file-row" id="attachTalkList"></div>
                </div>

                <!-- 相關事證 -->
                <div class="attach-section-card">
                    <div class="attach-section-title">相關事證</div>
                    <div class="attach-file-row" id="attachEvidenceList"></div>
                </div>

                <!-- 查扣物品 -->
                <div class="attach-section-card">
                    <div class="attach-section-title">查扣物品</div>
                    <div class="attach-file-row" id="attachSeizedList"></div>
                </div>

                <!-- 其他 -->
                <div class="attach-section-card">
                    <div class="attach-section-title">其他</div>
                    <div class="attach-file-row" id="attachOtherList"></div>
                </div>

            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        let currentPhotoInputId = '';
        let currentPhotoListId = '';

        const photoStore = {
            photoViolationList: [],
            photoVestList: [],
            photoSampleList: [],
            photoOtherList: []
        };


        let currentAttachInputId = '';
        let currentAttachListId = '';

        const attachStore = {
            attachTalkList: [],
            attachEvidenceList: [],
            attachSeizedList: [],
            attachOtherList: []
        };

        document.addEventListener('DOMContentLoaded', function () {
            const tabButtons = document.querySelectorAll('.inspect-tab-btn');
            const tabPanels = document.querySelectorAll('.inspect-tab-panel');

            tabButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const targetId = this.getAttribute('data-tab');

                    tabButtons.forEach(x => x.classList.remove('active'));
                    tabPanels.forEach(x => x.classList.remove('active'));

                    this.classList.add('active');

                    const panel = document.getElementById(targetId);
                    if (panel) {
                        panel.classList.add('active');
                    }
                });
            });

            renderPhotoList('photoViolationList');
            renderPhotoList('photoVestList');
            renderPhotoList('photoSampleList');
            renderPhotoList('photoOtherList');

            renderAttachList('attachTalkList');
            renderAttachList('attachEvidenceList');
            renderAttachList('attachSeizedList');
            renderAttachList('attachOtherList');
        });


        //照片用的script
        function openPhotoModal(title, inputId, listId) {
            const currentList = photoStore[listId] || [];

            if (currentList.length >= 3) {
                alert('上傳照片不得超過三個');
                return;
            }

            currentPhotoInputId = inputId;
            currentPhotoListId = listId;

            document.getElementById('photoModalTitle').textContent = title;
            document.getElementById('photoUploadModal').classList.add('show');

            renderPhotoModalPreview();

        }

        function closePhotoModal() {
            document.getElementById('photoUploadModal').classList.remove('show');
        }

        function closePhotoModalByOverlay(event) {
            if (event.target.id === 'photoUploadModal') {
                closePhotoModal();
            }
        }

        function choosePhotoFile() {
            if (!currentPhotoInputId) return;

            const input = document.getElementById(currentPhotoInputId);
            if (input) {
                input.click();
            }
        }

        function handlePhotoFiles(input) {
            if (!currentPhotoListId) return;

            const files = Array.from(input.files || []);
            if (!files.length) return;

            const currentList = photoStore[currentPhotoListId] || [];
            let remainCount = 3 - currentList.length;

            if (remainCount <= 0) {
                alert('上傳照片不得超過三個');
                input.value = '';
                return;
            }

            const validFiles = [];

            for (let i = 0; i < files.length; i++) {
                const file = files[i];

                if (!file.type.startsWith('image/')) {
                    continue;
                }

                if (file.size > 2 * 1024 * 1024) {
                    alert('照片大小不得超過2MB');
                    continue;
                }

                if (remainCount <= 0) {
                    alert('上傳照片不得超過三個');
                    break;
                }

                validFiles.push({
                    name: file.name,
                    size: file.size,
                    file: file,
                    url: URL.createObjectURL(file)
                });

                remainCount--;
            }

            photoStore[currentPhotoListId] = currentList.concat(validFiles);

            renderPhotoList(currentPhotoListId);
            renderPhotoModalPreview();

            input.value = '';
        }

        function renderPhotoList(listId) {
            const container = document.getElementById(listId);
            if (!container) return;

            const files = photoStore[listId] || [];

            if (!files.length) {
                container.innerHTML = '<div class="photo-empty-tip">尚未上傳照片</div>';
                return;
            }

            container.innerHTML = files.map((item, index) => `
                <div class="photo-thumb-item">
                    <div class="photo-thumb-box">
                        <img src="${item.url}" alt="${escapeHtml(item.name)}" />
                    </div>
                    <div class="photo-thumb-name">${escapeHtml(item.name)}</div>
                    <button type="button" class="photo-thumb-remove" onclick="removePhoto('${listId}', ${index})">移除</button>
                </div>
            `).join('');
        }

        function renderPhotoModalPreview() {
            const container = document.getElementById('photoModalPreview');
            if (!container || !currentPhotoListId) return;

            const files = photoStore[currentPhotoListId] || [];

            if (!files.length) {
                container.innerHTML = '<div class="photo-empty-tip">尚未上傳照片</div>';
                return;
            }

            container.innerHTML = files.map((item, index) => `
                <div class="photo-thumb-item">
                    <div class="photo-thumb-box">
                        <img src="${item.url}" alt="${escapeHtml(item.name)}" />
                    </div>
                    <div class="photo-thumb-name">${escapeHtml(item.name)}</div>
                    <button type="button" class="photo-thumb-remove" onclick="removePhoto('${currentPhotoListId}', ${index})">移除</button>
                </div>
            `).join('');
        }

        function removePhoto(listId, index) {
            const list = photoStore[listId] || [];
            const removed = list[index];

            if (removed && removed.url) {
                URL.revokeObjectURL(removed.url);
            }

            list.splice(index, 1);
            photoStore[listId] = list;

            renderPhotoList(listId);

            if (currentPhotoListId === listId) {
                renderPhotoModalPreview();
            }
        }

        function escapeHtml(str) {
            return (str || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function triggerUpload(inputId) {
            const input = document.getElementById(inputId);
            if (input) {
                input.click();
            }
        }


        // 附件用的script
        function openAttachModal(title, inputId, listId) {
            const currentList = attachStore[listId] || [];

            if (currentList.length >= 3) {
                alert('上傳附件不得超過三個');
                return;
            }

            currentAttachInputId = inputId;
            currentAttachListId = listId;

            document.getElementById('attachModalTitle').textContent = title;
            document.getElementById('attachUploadModal').classList.add('show');

            renderAttachModalPreview();
        }

        function closeAttachModal() {
            document.getElementById('attachUploadModal').classList.remove('show');
        }

        function closeAttachModalByOverlay(event) {
            if (event.target.id === 'attachUploadModal') {
                closeAttachModal();
            }
        }

        function chooseAttachFile() {
            if (!currentAttachInputId) return;

            const input = document.getElementById(currentAttachInputId);
            if (input) {
                input.click();
            }
        }

        function handleAttachFiles(input) {
            if (!currentAttachListId) return;

            const files = Array.from(input.files || []);
            if (!files.length) return;

            const currentList = attachStore[currentAttachListId] || [];
            let remainCount = 3 - currentList.length;

            if (remainCount <= 0) {
                alert('上傳附件不得超過三個');
                input.value = '';
                return;
            }

            const validFiles = [];
            const allowedExts = ['doc', 'docx', 'xls', 'xlsx', 'pdf', 'ods', 'jpg', 'jpeg', 'png'];

            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const ext = (file.name.split('.').pop() || '').toLowerCase();

                if (!allowedExts.includes(ext)) {
                    alert('附件格式不符，僅允許 Word、Excel、PDF、ODS、JPG、PNG');
                    continue;
                }

                if (file.size > 10 * 1024 * 1024) {
                    alert('附件大小不得超過10MB');
                    continue;
                }

                if (remainCount <= 0) {
                    alert('上傳附件不得超過三個');
                    break;
                }

                validFiles.push({
                    name: file.name,
                    size: file.size,
                    file: file,
                    ext: ext
                });

                remainCount--;
            }

            attachStore[currentAttachListId] = currentList.concat(validFiles);

            renderAttachList(currentAttachListId);
            renderAttachModalPreview();

            input.value = '';
        }

        function renderAttachList(listId) {
            const container = document.getElementById(listId);
            if (!container) return;

            const files = attachStore[listId] || [];

            if (!files.length) {
                container.innerHTML = '<div class="photo-empty-tip">尚未上傳附件</div>';
                return;
            }

            container.innerHTML = files.map((item, index) => `
                <div class="attach-file-item">
                    <div class="attach-file-main">
                        <span class="attach-file-icon ${getAttachIconClass(item.ext)}">${getAttachIconText(item.ext)}</span>
                        <div class="attach-file-meta">
                            <div class="attach-file-name">${escapeHtml(item.name)}</div>
                            <div class="attach-file-size">檔案大小:${formatFileSize(item.size)}</div>
                        </div>
                    </div>
                    <button type="button" class="attach-file-remove" onclick="removeAttach('${listId}', ${index})">×</button>
                </div>
            `).join('');
        }

        function renderAttachModalPreview() {
            const container = document.getElementById('attachModalPreview');
            if (!container || !currentAttachListId) return;

            const files = attachStore[currentAttachListId] || [];

            if (!files.length) {
                container.innerHTML = '<div class="photo-empty-tip">尚未上傳附件</div>';
                return;
            }

            container.innerHTML = files.map((item, index) => `
                <div class="attach-file-item">
                    <div class="attach-file-main">
                        <span class="attach-file-icon ${getAttachIconClass(item.ext)}">${getAttachIconText(item.ext)}</span>
                        <div class="attach-file-meta">
                            <div class="attach-file-name">${escapeHtml(item.name)}</div>
                            <div class="attach-file-size">檔案大小:${formatFileSize(item.size)}</div>
                        </div>
                    </div>
                    <button type="button" class="attach-file-remove" onclick="removeAttach('${currentAttachListId}', ${index})">×</button>
                </div>
            `).join('');
        }

        function removeAttach(listId, index) {
            const list = attachStore[listId] || [];
            list.splice(index, 1);
            attachStore[listId] = list;

            renderAttachList(listId);

            if (currentAttachListId === listId) {
                renderAttachModalPreview();
            }
        }

        function getAttachIconClass(ext) {
            ext = (ext || '').toLowerCase();

            if (['pdf'].includes(ext)) return 'pdf';
            if (['doc', 'docx'].includes(ext)) return 'word';
            if (['xls', 'xlsx', 'ods'].includes(ext)) return 'excel';
            if (['jpg', 'jpeg', 'png'].includes(ext)) return 'img';

            return 'pdf';
        }

        function getAttachIconText(ext) {
            ext = (ext || '').toLowerCase();

            if (['pdf'].includes(ext)) return 'PDF';
            if (['doc', 'docx'].includes(ext)) return 'W';
            if (['xls', 'xlsx', 'ods'].includes(ext)) return 'X';
            if (['jpg', 'jpeg', 'png'].includes(ext)) return 'IMG';

            return 'FILE';
        }

        function formatFileSize(size) {
            if (!size && size !== 0) return '0MB';
            return (size / 1024 / 1024).toFixed(2) + 'MB';
        }
    </script>
}