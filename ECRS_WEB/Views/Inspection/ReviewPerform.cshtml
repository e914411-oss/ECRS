    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate,
    .dataTables_wrapper .dataTables_length {
        display: none !important;
    }

    /* ===== 自訂分頁列 ===== */
    .dt-footer-bar {
        border: 2px solid #b9dfc1;
        border-top: none;
        border-radius: 0 0 10px 10px;
        background: #f7f7f7;
        padding: 18px 22px;
        display: flex;
        align-items: center;
