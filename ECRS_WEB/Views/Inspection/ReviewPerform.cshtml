            $("#citySelect").change(function () {
                var cityId = $(this).val();

                $.ajax({
                    url: '/Inspection/GetCityAreaByCity',
                    type: 'GET',
                    data: { cityId: cityId },
                    success: function (data) {

                        var areaSelect = $("#areaSelect");
                        areaSelect.empty();

                        areaSelect.append('<option value="">全部</option>');

                        $.each(data, function (i, item) {
                            areaSelect.append(
                                '<option value="' + item.鄉鎮區代碼 + '">' + item.機構縣市鄉鎮市區 + '</option>'
                            );
                        });

                        // 如果使用 bootstrap-select
                        //areaSelect.selectpicker('refresh');
                    }
                });

            });

            $("#mainSelect").change(function () {

                var kindId = $(this).val();

                $.ajax({
                    url: '/Inspection/GetSubByKind',
                    type: 'GET',
                    data: { kindId: kindId },
                    success: function (data) {

                        var areaSelect = $("#subSelect");
                        areaSelect.empty();

                        areaSelect.append('<option value="">全部</option>');

                        $.each(data, function (i, item) {
                            areaSelect.append(
                                '<option value="' + item.主鍵 + '">' + item.業別次分類名稱 + '</option>'
                            );
                        });

                        // 如果使用 bootstrap-select
                        //areaSelect.selectpicker('refresh');
                    }
                });

            });

        });
