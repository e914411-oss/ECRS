@model ECRS_WEB.DTOs.InspectionDTO.PReview.CheckRecMDViewModel

@{
    ViewData["Title"] = "待審核案件-審核作業";
}

<style>
#modal {
    position: fixed;          /* 固定在畫面 */
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;

    display: none;            /* 使用 flex 置中 */
    justify-content: center;  /* 水平置中 */
    align-items: center;      /* 垂直置中 */

    background-color: rgba(0, 0, 0, 0.3); /* 半透明背景(可選) */
}

    #modalRec {
        position: fixed; /* 固定在畫面 */
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        display: none; /* 使用 flex 置中 */
        justify-content: center; /* 水平置中 */
        align-items: center; /* 垂直置中 */

        background-color: rgba(0, 0, 0, 0.3); /* 半透明背景(可選) */
    }

.modal-content1 {
        position: relative; /* 關鍵 */

        width: 400px;
        height: 400px;
        background: white;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column; /* 直向排列 */
    }

    /* 標題列 */
    .modal-header {
        display: flex;
        position: relative;
        width: 100%; /* 填滿 */
        background: #f0f0f0;
        padding: 12px 0;
        text-align: center; /* 文字置中 */
        font-weight: bold;
        border-bottom: 1px solid #ddd;
    }

    /* 標題文字 */
    .modal-title {
        width: 100%; /* 填滿 */
        text-align: left; /* 文字置中 */
        font-size: 16px;
    }

    /* 內容區 */
    .modal-contentb {
        width: 100%; /* 填滿 */
        height: 100%;
        flex: 1; /* ⭐ 自動撐滿剩餘空間 */

        padding: 10px;
    }
    .modal-content {
        width: 100%; /* 填滿 */
        height: 100%;
        padding: 10px;
        border: 1px solid #ccc; /* 灰色邊框 */
    }

    /* 右上角按鈕 */
    .close-btn {
        position: absolute; /* 關鍵 */
        top: 5px;
        right: 5px;
        background: transparent;
        color: black;
        border: none;
        cursor: pointer;
        width: 55px;
        height: 25px;
    }

        .close-btn:hover {
            color: red;
        }

    /* Footer */
    .modal-footerx {
        flex-direction: column;
        justify-content: flex-end; /* 右對齊 */
        align-items: flex-end;
        gap: 20px; /* 按鈕間距 */
        border-top: 1px solid #ddd;
    }

    /* 按鈕樣式 */
    .close-btnC {
        background: #ccc;
        border: none;
        cursor: pointer;
    }

    .close-btnS {

        background: #007bff;
        color: white;
        border: none;
        cursor: pointer;
    }

        .close-btnS:hover {
            background: #0056b3;
        }


    th {
        text-wrap: nowrap;
    }

    .main-title {
        position: relative;
        display: block;
        margin: 0 0 24px 0;
        padding-left: 16px;
