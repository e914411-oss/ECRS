    }

    .action-stack {
        display: inline-flex;
        flex-direction: column;
        gap: 8px;
    }

        .action-stack .btn {
            min-width: 68px;
            border-radius: 4px;
        }

    .btn-outline-ecrs {
        color: #66b96e;
        border: 1px solid #7fc987;
        background: #fff;
    }

        .btn-outline-ecrs:hover {
            color: #fff;
            background: #66b96e;
