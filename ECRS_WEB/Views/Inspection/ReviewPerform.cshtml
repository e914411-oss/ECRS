</style>

<h1 class="main-title">
    <span id="ctl00_ContentPlaceHolder1_UC_NodeName_lblNodeName">@ViewData["Title"]</span>
</h1>
<div class="content" id="ctl00_ContentPlaceHolder1_Panel1">
    <button class="btn btn-danger px-4" onclick="openModal('@Model.Mast.稽查單號')">退回案件</button>
    <button class="btn btn-success px-4" onclick="closeModal(); alert('此項稽查表單拋轉至PMDS後，該表單將不可再次進行修改');">核准案件</button>

    <h6 class="mt-3 row"><span>稽查單內容 </span></h6>
    <div class="visible-xs mb5"></div>
    <div class="form-editer-card" id="tab-1">

        <div class="mb-0 row">
            <label class="col-sm-2 col-form-label text-end">表單編號：</label>
            <div class="col-sm-4">
                <span class="form-control-plaintext">
                    @Model.Mast.稽查單號
                </span>
            </div>
            <label class="col-sm-2 col-form-label text-end">稽查日期：</label>
            <div class="col-sm-4 ">
                <span class="form-control-plaintext">
                    @Html.DisplayFor(modelItem => Model.Mast.稽查日期)
                </span>
            </div>
        </div>

        <div class="mb-0 row">
            <label class="col-sm-2 mb-2 col-form-label text-end">稽查員：</label>
            <div class="col-sm-4 mb-2">
                <span class="form-control-plaintext">
                    @Model.Mast.稽查人員
                </span>
            </div>
            <label class="col-sm-2 mb-2 col-form-label text-end">機構代碼：</label>
            <div class="col-sm-4 mb-2">
                <span class="form-control-plaintext">
                    @(string.IsNullOrEmpty(Model.Mast.機構代碼) ? "\u00A0" : Model.Mast.機構代碼)
                </span>
            </div>
        </div>

        <div class="mb-0 row">
            <label class="col-sm-2 col-form-label text-end">業者名稱：</label>
            <div class="col-sm-4 ">
                <span class="form-control-plaintext">
                    @Model.Mast.業者名稱
                </span>
            </div>
            <label class="col-sm-2 mb-2 col-form-label text-end">業者電子信箱：</label>
            <div class="col-sm-4 mb-2">
                <span class="form-control-plaintext">
                    @(string.IsNullOrEmpty(Model.Mast.業者電子信箱) ? "\u00A0" : Model.Mast.業者電子信箱)
                </span>
            </div>
        </div>

        <div class="mb-0 row">
            <label class="col-sm-2 mb-2 col-form-label text-end">負責人：</label>
            <div class="col-sm-4 mb-2">
                <span class="form-control-plaintext">
                    @(string.IsNullOrEmpty(Model.Mast.負責人) ? "\u00A0" : Model.Mast.負責人)
                </span>
            </div>
            <label class="col-sm-2 mb-2 col-form-label text-end">業者電話：</label>
            <div class="col-sm-4 mb-2">
                <span class="form-control-plaintext">
                    @(string.IsNullOrEmpty(Model.Mast.業者電話) ? "\u00A0" : Model.Mast.業者電話)
                </span>
            </div>
        </div>

        <div class="mb-0 row">
            <label class="col-sm-2 mb-2 col-form-label text-end">業者地址：</label>
            <div class="col-sm-3 mb-2">
                <select asp-for="Mast.業者地址_縣市主鍵" class="form-control" disabled style="display:none">
                    <option value="">全部</option>
                    <option value="01">台北市</option>
                    <option value="07">高雄市</option>
                    <option value="45">花蓮縣</option>
                </select>

                <input id="citySelF" type="hidden" asp-for="Mast.業者地址_縣市主鍵" />
                <input id="noteID" type="hidden"  />

                <select id="areaSelectF" asp-for="Mast.業者地址_鄉鎮區主鍵" class="form-control bg-transparent border-0 text-end" disabled>
                    <option value="">全部</option>
                </select>

                <input id="areaSelF" type="hidden" asp-for="Mast.業者地址_鄉鎮區主鍵" />
            </div>
            <div class="col-sm-7 mb-2">
                <div class="form-group">
                    <span class="form-control-plaintext text-start">
                        @(string.IsNullOrEmpty(Model.Mast.業者地址) ? "\u00A0" : Model.Mast.業者地址)
                    </span>
                </div>
            </div>

        </div>

    </div>
    <br />
    <h4 class="secend-title"><span>稽查紀錄 </span></h4>
    <div class="visible-xs mb5"></div>
    <!-- END pull-right -->
    <div class="form-list-card">

        <div class="form-list-wrap">
            <table id="checkRecTable" class="table table-bordered table-striped tb-multi">
                <thead>
                    <tr>
                        <th>操作</th>
                        <th>稽查表單</th>
                        <th>稽查人員</th>
                        <th>稽查日期</th>
                        <th>稽查結果</th>
                        <th>限改日期</th>
                        <th>執行狀態</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int ii = 1;
                    }
                    @if (Model == null || Model.CheckRecs.Count == 0)
                    {
 
                    }
                    else
                    {
                        @foreach (var item in Model.CheckRecs)
                        {
                            <tr>
                                <td>
                                    <a href="javascript:void(0);" onclick=" openModalPerform('@item.稽查單號'); return false;" class="btn btn-icon view" title="檢視"><i class="bi bi-eye"></i></a>

                                </td>
                                <td class="lt">@item.稽查表單 稽查專案紀錄表</td>
                                <td class="lt">@item.稽查人員</td>
                                <td class="lt">@Html.DisplayFor(modelItem => item.稽查日期)</td>
                                <td>@item.稽查結果</td>
                                <td class="lt"></td>
                                <td class="lt">@item.執行狀態</td>

                            </tr>
                            ii++;
                        }
                    }

                </tbody>
            </table>
        </div>
        <!-- table-responsive -->


    </div>

    <div id="modal" style="display:none" >
        <div class="modal-content1">

            <!-- 標題列 -->
            <div class="modal-header">
                <span class="modal-title">　退回案件-簽核意見</span>
            </div>
            <div class="modal-contentb">
                <div class="modal-content">
                
                    <textarea rows="10" id="note" style="width: 100%;" placeholder="請輸入內容..."></textarea>

                </div>
            </div>
            <div class="modal-footer">
                <button class="close-btnS" onclick="closeNoteModal();">
                    <i class="bi bi-check-lg me-1"></i> 確定
                </button>
                <button class="close-btnC" onclick="closeModal()">
                    <i class="bi bi-x-lg me-1"></i> 取消
                </button>
            </div>
            <button class="close-btn" onclick="closeModal()">✕</button>
        </div>

    </div>

    <div id="modalRec" style="display:none">
        <div class="modal-content1">

            <!-- 標題列 -->
            <div class="modal-header">
                <div class="modal-contentH">
                <span class="modal-title" style="margin-left: 12px;">
                    114年度食品業稽查專案紀錄表-稽查內容
                </span>
                </div>
            </div>
            <div class="modal-contentb">
                <div class="modal-content">
                    辣椒粉有蘇丹紅-裁罰
                </div>
            </div>
            <button class="close-btn" onclick="closeModalRec()">✕</button>
        </div>

    </div>
</div>


@section Scripts {
    <script>
        function openModal(noteID) {
            document.getElementById("modal").style.display = "flex";
            var response = " 不夠詳細. ";
            document.getElementById("noteID").val = noteID;
            //alert(document.getElementById("noteID").val);

            //$("#modal div.modal-content").html(response);
            //document.querySelector("#modal .modal-content").innerHTML = response;

            //var myModal = new bootstrap.Modal(document.getElementById('modal'));
            //myModal.show();
        }

        function closeModal() {
            document.getElementById("modal").style.display = "none";
        }

        function closeModalRec() {
            document.getElementById("modalRec").style.display = "none";
        }


        function closeNoteModal() {
            const textn = document.getElementById("note").value; //意見
            var noteId = document.getElementById("noteID").val;
            var eventI = {
                eventId: noteId
            };
            //alert(textn);
            //alert(noteId);
            $.ajax({
                url: '/Inspection/ReviewUpdate',
                type: 'POST',
                cache: false,
                data: {
                    eventId: noteId,
                    note: textn
                },
                success: function (result) {
                    alert('案件退回');
                    window.location.href = '/Inspection/ReviewPerform?' + $.param(eventI);
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    //alert(jqXHR.responseText);
                    //alert(jqXHR.status);
                    //alert(textStatus);
                    //alert(errorThrown);
                    alert("退回失敗");
                }

            });

            document.getElementById("modal").style.display = "none";
        }

        function openModalPerform(noteId) {
            //alert(noteId);
            //document.getElementById("noteID").val = noteId;
            //alert(document.getElementById("noteID").val);
            document.getElementById("modalRec").style.display = "flex";
            document.querySelector("#modalRec .modal-contentH").innerHTML =
            '<span class="modal-title" style="margin-left: 12px;">食品業稽查專案-稽查內容</span>';
             var response = " 無 ";
            //$("#modalRec div.modal-content").html(note);
            document.querySelector("#modalRec .modal-content").innerHTML = response;
        }

        $(document).ready(function () {

            var cityIdF = $("#citySelF").val();
            var areaIdF = $("#areaSelF").val();

            $.ajax({
                url: '/Inspection/GetCityAreaByCity',
                type: 'GET',
                data: { cityId: cityIdF },
                success: function (data) {

                    var areaSelect = $("#areaSelectF");
                    areaSelect.empty();

                    //areaSelect.append('<option value="">全部</option>');

                    $.each(data, function (i, item) {
                        if (areaIdF == item.鄉鎮區代碼) {
                            areaSelect.append(
                                '<option value="' + item.鄉鎮區代碼 + '">' + item.機構縣市鄉鎮市區 + '</option>'
                            );
                        }
                    });

                }
            });


            $('#checkRecTable').DataTable({
                pageLength: 10,
