@{
    ViewData["Title"] = "稽查管理-稽查作業-表單查詢";

    bool isCompleted = TempData["IsCompleted"] != null && TempData["IsCompleted"] is bool b && b;
    string FormName = TempData["FormName"]?.ToString() ?? string.Empty;
}

@section Styles {
    <style>
        /* 共用 */
        th {
            text-wrap: nowrap;
        }

        .main-title {
            position: relative;
            display: block;
            margin: 0 0 24px 0;
            padding-left: 16px;
            font-size: 24px;
            font-weight: 700;
            line-height: 1.5;
            color: #222;
        }

            .main-title::before {
                content: "";
                position: absolute;
                top: 50%;
                left: 0;
                width: 5px;
                height: 23px;
                background: #349f41;
                border-radius: 5px;
                transform: translateY(-50%);
            }

        .secend-title {
            position: relative;
            display: block;
            margin: 0 0 24px 0;
            padding-left: 16px;
            font-size: 18px;
            font-weight: 640;
            line-height: 1.5;
            color: #222;
        }

            .secend-title::before {
                content: "";
                position: absolute;
                top: 50%;
                left: 0;
                width: 5px;
                height: 23px;
                background: #349f41;
                border-radius: 5px;
                transform: translateY(-50%);
            }

        .form-editer-page {
            padding-bottom: 24px;
        }

        .form-editer-card {
            border: 2px solid #7ecb8a;
            border-radius: 8px;
            background: #f7fbf7;
            padding: 28px 18px 36px 18px;
            box-shadow: 0 0 0 4px rgba(126, 203, 138, .15);
            position: relative;
        }

        .form-editer-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px 28px;
        }

        .form-editer-col {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .query-row {
            display: grid;
            grid-template-columns: 150px minmax(220px, 1fr);
            align-items: center;
            gap: 10px;
        }

            .query-row.query-row-status {
                align-items: center;
            }

        .query-label {
            margin: 0;
            font-size: 16px;
            color: #333;
            white-space: nowrap;
        }

        .query-inline {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .query-inline > .form-control,
            .query-inline > .form-select {
                flex: 1 1 auto;
            }

        .date-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

            .date-input-wrap .form-control {
                padding-right: 42px;
            }

            .date-input-wrap .date-icon {
                position: absolute;
                right: 12px;
                color: #4caf50;
                pointer-events: none;
                font-size: 16px;
            }

        .pmds-radio-group {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

            .pmds-radio-group .radio-inline-item {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                margin: 0;
                white-space: nowrap;
                font-weight: normal;
            }

                .pmds-radio-group .radio-inline-item input[type="radio"] {
                    margin: 0;
                }

        .collapse-anchor-wrap {
            position: absolute;
            left: -10px;
            bottom: -14px;
        }

        .collapse-toggle-fake {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: #fff;
            border: 1px solid #d9d9d9;
            border-radius: 4px;
            color: #666;
            text-decoration: none;
            font-size: 14px;
            box-shadow: 0 1px 2px rgba(0,0,0,.08);
        }

            .collapse-toggle-fake:hover {
                color: #333;
                text-decoration: none;
            }

        .query-action-area {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 14px;
            margin: 30px 0 40px;
        }

        .table-title-row {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .btn-add-form {
            min-width: 160px;
        }

        /* ===== 查詢筆數 ===== */
        .query-summary {
            color: #1f9d46;
            font-size: 16px;
            margin-bottom: 10px;
        }

        /* ===== DataTable 外框 ===== */
        .form-list-card {
            border: 2px solid #b9dfc1;
            border-radius: 10px;
            overflow: hidden;
            background: #fff;
        }

        .form-list-wrap {
            padding: 6px 10px 0 10px;
        }

        table.dataTable.form-list-table {
            width: 100% !important;
            border-collapse: collapse !important;
            margin: 0 !important;
        }

            table.dataTable.form-list-table thead th {
                background: #cddccf;
                color: #222;
                font-size: 18px;
                font-weight: 700;
                text-align: center;
                padding: 14px 10px;
                border-bottom: 1px solid #b7c9b8 !important;
                white-space: nowrap;
            }

            table.dataTable.form-list-table tbody td {
                font-size: 16px;
                color: #222;
                text-align: center;
                vertical-align: middle;
                padding: 14px 12px;
                border-bottom: 1px solid #d8d8d8 !important;
                background: #fff;
            }

            table.dataTable.form-list-table tbody tr:last-child td {
                border-bottom: none !important;
            }

        .td-project-item,
        .td-project-name {
            text-align: left;
            line-height: 1.6;
        }

        .td-edit-date {
            line-height: 1.5;
            white-space: nowrap;
        }

        .status-text {
            color: #2d7a2d;
            font-weight: 500;
        }

        .action-stack {
            display: inline-flex;
            flex-direction: column;
            gap: 8px;
        }

            .action-stack .btn {
                min-width: 68px;
                border-radius: 4px;
            }

        .btn-outline-ecrs {
            color: #66b96e;
            border: 1px solid #7fc987;
            background: #fff;
        }

            .btn-outline-ecrs:hover {
                color: #fff;
                background: #66b96e;
                border-color: #66b96e;
            }

        /* 關掉 DataTables 預設小箭頭佔位 */
        table.dataTable thead > tr > th.sorting,
        table.dataTable thead > tr > th.sorting_asc,
        table.dataTable thead > tr > th.sorting_desc,
        table.dataTable thead > tr > th.sorting_asc_disabled,
        table.dataTable thead > tr > th.sorting_desc_disabled {
            padding-right: 10px !important;
            background-image: none !important;
        }

        /* ===== 隱藏 DataTables 預設區塊 ===== */
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate,
        .dataTables_wrapper .dataTables_length {
            display: none !important;
        }

        /* ===== 自訂分頁列 ===== */
        .dt-footer-bar {
            border: 2px solid #b9dfc1;
            border-top: none;
            border-radius: 0 0 10px 10px;
            background: #f7f7f7;
            padding: 18px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }

        .dt-footer-left,
        .dt-footer-right {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .dt-footer-center {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            color: #222;
            font-size: 16px;
        }

        .dt-page-btn {
            border: none;
            background: transparent;
            color: #4aa658;
            font-size: 24px;
            line-height: 1;
            padding: 0 6px;
        }

            .dt-page-btn:disabled {
                opacity: .35;
                cursor: not-allowed;
            }

        .dt-page-box,
        .dt-length-box {
            min-width: 58px;
            height: 34px;
            border: 1px solid #d7d7d7;
            border-radius: 4px;
            background: #fff;
            text-align: center;
            padding: 4px 28px 4px 8px;
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
        }

        .dt-select-wrap {
            position: relative;
            display: inline-flex;
            align-items: center;
        }

            .dt-select-wrap::after {
                content: "";
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-30%);
                border-left: 5px solid transparent;
                border-right: 5px solid transparent;
                border-top: 6px solid #58a45d;
                pointer-events: none;
            }

        .dt-divider {
            color: #666;
        }

        @@media (max-width: 992px) {
            .form-editer-grid {
                grid-template-columns: 1fr;
            }

            .dt-footer-bar {
                justify-content: center;
            }

            .dt-footer-left,
            .dt-footer-center,
            .dt-footer-right {
                width: 100%;
                justify-content: center;
            }
        }

        @@media (max-width: 576px) {
            .query-row {
                grid-template-columns: 1fr;
                gap: 6px;
            }

            .query-label {
                white-space: normal;
            }

            .collapse-anchor-wrap {
                position: static;
                margin-top: 16px;
            }

            .form-editer-card {
                padding-bottom: 20px;
            }

            table.dataTable.form-list-table thead th,
            table.dataTable.form-list-table tbody td {
                font-size: 14px;
                padding: 10px 8px;
            }
        }





        .vendor-info-panel {
            margin-bottom: 16px;
        }

        .vendor-info-title {
            font-size: 22px;
            font-weight: 700;
            color: #222;
            margin: 10px 0 12px 0;
            padding-left: 14px;
            border-left: 4px solid #2fa84f;
        }

        .vendor-info-box {
            background: #f7f7f7;
            border: 1px solid #d8d8d8;
            border-radius: 4px;
            padding: 0;
            overflow: hidden;
        }

        .vendor-info-table {
            width: 100%;
            margin-bottom: 0;
            border-collapse: collapse;
            table-layout: fixed;
            background: #fff;
        }

            .vendor-info-table th,
            .vendor-info-table td {
                border: 1px solid #d9d9d9;
                vertical-align: middle;
                padding: 12px 14px;
                font-size: 18px;
            }

        .vendor-label {
            width: 160px;
            background: #e6e6e6;
            color: #111;
            font-weight: 700;
            text-align: center;
            white-space: nowrap;
        }

        .vendor-value {
            background: #fff;
            color: #222;
        }

        .vendor-date-wrap {
            width: 360px;
            max-width: 100%;
        }

        .vendor-date-input {
            width: 100%;
            height: 42px;
            border: 1px solid #cfd4da;
            border-radius: 6px;
            font-size: 16px;
            padding: 6px 12px;
            background-color: #fff;
        }

        .vendor-input {
            width: 100%;
            height: 42px;
            border: 1px solid #cfd4da;
            border-radius: 6px;
            font-size: 16px;
            padding: 6px 12px;
            background-color: #fff;
        }

        .vendor-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .vendor-tag {
            display: inline-block;
            min-width: 70px;
            height: 38px;
            border: 1px solid #d5d5d5;
            border-radius: 18px;
            background: #fff;
        }

        .vendor-tag-wide {
            min-width: 220px;
        }

        .vendor-tag-btn {
            min-width: 110px;
            background: #e9ecef;
        }

        input[type="date"]::-webkit-calendar-picker-indicator {
            cursor: pointer;
            opacity: 1;
        }

        /* ===== 表單列表標題列 + 按鈕列 ===== */
        .form-list-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin:24px 0 0 0;
        }

            .form-list-header .table-tit {
                margin-bottom: 0;
            }

        .form-toolbar {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .form-toolbar-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-width: 120px;
            height: 44px;
            padding: 0 18px;
            /* border: 2px solid #8dc7c7; */
            border: 2px solid;
            border-radius: 999px;
            background: linear-gradient(to bottom, #f9ffff, #edf8f9 );
            /* color: #fff; */
            color: forestgreen;
            font-size: 18px;
            font-weight: 700;
            text-decoration: none;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.25);
            transition: all .2s ease-in-out;
            white-space: nowrap;
            cursor: pointer;
        }

            .form-toolbar-btn:hover {
                background: linear-gradient(to bottom, #F0FFF0, #CEFFCE);
                color: forestgreen;
                transform: translateY(-1px);
            }

            .form-toolbar-btn:focus {
                color: forestgreen;
                outline: none;
                box-shadow: 0 0 0 0.2rem rgba(13, 148, 166, .25);
            }

            .form-toolbar-btn .toolbar-icon {
                font-size: 16px;
                line-height: 1;
            }

        @@media (max-width: 1200px) {
            .vendor-label {
                width: 130px;
                font-size: 16px;
                background: #e6e6e6;
            }

            .vendor-info-table th,
            .vendor-info-table td {
                font-size: 16px;
                padding: 10px;
            }

            .vendor-date-wrap {
                width: 280px;
            }

            .form-toolbar-btn {
                min-width: 105px;
                height: 40px;
                font-size: 16px;
                padding: 0 14px;
            }
        }

        @@media (max-width: 768px) {
            .form-list-header {
                flex-direction: column;
                align-items: stretch;
            }

            .form-toolbar {
                justify-content: flex-start;
            }
        }

        /* ===== 稽查結果彈窗 ===== */
        .inspect-result-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.28);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 3000;
            padding: 20px;
        }

            .inspect-result-overlay.show {
                display: flex;
            }

        .inspect-result-modal {
            width: 100%;
            max-width: 760px;
            background: #f2ffe5;
            border: 4px solid #e5fff2;
            border-radius: 22px;
            box-shadow: 0 10px 30px rgba(0,0,0,.18);
            overflow: hidden;
        }

        .inspect-result-header {
            padding: 22px 28px 14px 28px;
            /* background: #c8e0e4;
                                                                                            border-bottom: 1px solid #b8d0d4; */
            background: linear-gradient(to bottom, forestgreen, darkgreen);
            border-bottom: 1px solid forestgreen;
        }

        .inspect-result-title {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 34px;
            font-weight: 800;
            /* color: #1a1a1a; */
            color: white;
            line-height: 1.2;
        }

            .inspect-result-title .title-icon {
                font-size: 34px;
                /* color: #4d8e99; */
                color: white;
            }

        .inspect-result-body {
            padding: 18px 28px 28px 28px;
        }

        .inspect-result-select {
            width: 100%;
            height: 62px;
            font-size: 24px;
            color: #333;
            border: 1px solid #cfcfcf;
            border-radius: 12px;
            background: #fff;
            padding: 0 18px;
            margin-bottom: 22px;
        }

        .inspect-result-remark {
            width: 100%;
            min-height: 140px;
            font-size: 22px;
            border: 1px solid #cfcfcf;
            border-radius: 12px;
            background: #fff;
            padding: 16px 18px;
            resize: vertical;
        }

        .inspect-result-actions {
            display: flex;
            justify-content: center;
            gap: 18px;
            margin-top: 24px;
            flex-wrap: wrap;
        }

        .inspect-result-btn {
            min-width: 140px;
            height: 48px;
            border: none;
            border-radius: 10px;
            font-size: 20px;
            font-weight: 700;
            cursor: pointer;
            transition: .2s ease;
        }

        .inspect-result-btn-confirm {
            background: #2f9e44;
            color: #fff;
        }

            .inspect-result-btn-confirm:hover {
                background: #28863a;
            }

        .inspect-result-btn-cancel {
            background: #d9d9d9;
            color: #222;
        }

            .inspect-result-btn-cancel:hover {
                background: #c8c8c8;
            }

        @@media (max-width: 768px) {
            .inspect-result-title {
                font-size: 28px;
            }

                .inspect-result-title .title-icon {
                    font-size: 28px;
                }

            .inspect-result-select {
                height: 52px;
                font-size: 18px;
            }

            .inspect-result-remark {
                min-height: 110px;
                font-size: 18px;
            }
        }


        /* ===== 業者簽名欄位選擇彈窗 ===== */
        .vendor-sign-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.28);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 3100;
            padding: 20px;
        }

            .vendor-sign-overlay.show {
                display: flex;
            }

        .vendor-sign-modal {
            width: 100%;
            max-width: 1500px;
            background: #f2ffe5;
            border: 1px solid #e5fff2;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 12px 32px rgba(0,0,0,.22);
        }

        .vendor-sign-header {
            height: 96px;
            background: linear-gradient(to bottom, forestgreen, darkgreen);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
        }

        .vendor-sign-title {
            font-size: 28px;
            font-weight: 800;
            color: #fff;
            letter-spacing: 1px;
        }

        .vendor-sign-close {
            border: none;
            background: transparent;
            color: #fff;
            font-size: 44px;
            line-height: 1;
            cursor: pointer;
            padding: 0;
        }

        .vendor-sign-body {
            padding: 34px 34px 26px 34px;
            /* background: #f3f3f3; */
            background: #f2ffe5;
        }

        .vendor-sign-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(280px, 1fr));
            gap: 22px 32px;
            align-items: center;
            justify-items: center;
            margin-bottom: 34px;
        }

        .vendor-sign-item {
            width: 100%;
            max-width: 360px;
            height: 78px;
            border: 1px solid #d8d8d8;
            border-radius: 999px;
            background: #fff;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            font-size: 26px;
            font-weight: 700;
            color: #111;
            cursor: pointer;
            transition: all .2s ease;
            text-decoration: none;
        }

            .vendor-sign-item:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 14px rgba(0,0,0,.12);
                background: #f9ffff;
            }

        .vendor-sign-icon {
            font-size: 28px;
            color: #6ccfd8;
            line-height: 1;
        }

        .vendor-sign-bottom {
            display: flex;
            justify-content: center;
        }

        .vendor-sign-none {
            width: 100%;
            max-width: 420px;
            height: 78px;
            border: 1px solid #d8d8d8;
            border-radius: 999px;
            background: #fff;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            font-size: 26px;
            font-weight: 700;
            color: #111;
            cursor: pointer;
            transition: all .2s ease;
        }

            .vendor-sign-none:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 14px rgba(0,0,0,.12);
                background: #f9ffff;
            }

        @@media (max-width: 1200px) {
            .vendor-sign-grid {
                grid-template-columns: repeat(2, minmax(260px, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .vendor-sign-header {
                height: auto;
                padding: 18px 20px;
            }

            .vendor-sign-title {
                font-size: 22px;
            }

            .vendor-sign-close {
                font-size: 36px;
            }

            .vendor-sign-body {
                padding: 20px;
            }

            .vendor-sign-grid {
                grid-template-columns: 1fr;
                gap: 16px;
            }

            .vendor-sign-item,
            .vendor-sign-none {
                max-width: 100%;
                height: 64px;
                font-size: 20px;
            }

            .vendor-sign-icon {
                font-size: 22px;
            }
        }
    </style>
}


<h1 class="main-title">
    <span id="ctl00_ContentPlaceHolder1_UC_NodeName_lblNodeName">@ViewData["Title"]</span>
</h1>

<div class="content form-editer-page" style="min-height: 561px;">
    <!-- 廠商資訊 -->
    <div class="form-editer-card">
        <div class="form-editer-grid">
            <div class="form-editer-col">
                <div class="query-row">
                    <label class="query-label">稽查單號</label>
                    <div class="query-inline">
                        <span>12369854</span>
                    </div>
                </div>
                <div class="query-row">
                    <label class="query-label">複審狀態</label>
                    <div class="query-inline">
                        <span>&nbsp;</span>
                    </div>
                </div>
            </div>
            <div class="form-editer-col">
                <div class="query-row">
                    <label class="query-label">稽查日期</label>
                    <div class="query-inline">
                        <input type="date" class="form-control form-control datepicker" id="InspectionDate" value="2025-10-20" />
                    </div>
                </div>
                <div class="query-row">
                    <label class="query-label">稽查員</label>
                    <div class="query-inline">
                        <span>&nbsp;</span>
                    </div>
                </div>
            </div>
            <div class="form-editer-col">
                <div class="query-row">
                    <label class="query-label">縣市</label>
                    <div class="query-inline">
                        <span>&nbsp;</span>
                    </div>
                </div>
                <div class="query-row">
                    <label class="query-label">統一編號/身份證字號</label>
                    <div class="query-inline">
                        <span>&nbsp;</span>
                    </div>
                </div>
