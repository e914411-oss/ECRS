@{
    ViewData["Title"] = "稽查管理-稽查作業-表單：餐飲業 食品良好衛生規範準則 稽查記錄表";
    var partialViewNames = ViewBag.PartialViewNames as IEnumerable<string> ?? Enumerable.Empty<string>();
    var hasInspectionId = ViewBag.HasInspectionId as bool? ?? false;
    var shouldAlertNoInspectionItem = !hasInspectionId;
}

@section Styles {
    <style>
        .inspection-question-panel {
            margin-top: 24px;
        }

        .inspection-question-card {
            background: #f7f8f8;
            border: 1px solid #dfe5e7;
            border-radius: 12px;
            padding: 18px 18px 14px 18px;
            margin-bottom: 18px;
            box-shadow: 0 1px 4px rgba(0,0,0,.05);
        }

        .inspection-question-title {
            font-size: 18px;
            font-weight: 700;
            color: #222;
            line-height: 1.8;
            margin-bottom: 14px;
        }

        .inspection-question-body {
            background: #fff;
            border: 1px solid #e2e7ea;
            border-radius: 10px;
            padding: 14px;
        }

        .inspection-result-row {
            margin-bottom: 14px;
        }

        .inspection-result-select {
            height: 44px;
            border-radius: 8px;
            border: 1px solid #d6dde2;
            font-size: 16px;
            color: #444;
        }

        .inspection-upload-row {
            margin-bottom: 12px;
        }

        .inspection-upload-btn {
            min-width: 150px;
            height: 44px;
            border-radius: 24px;
            /* border: 2px solid #b9dfe2; */
            border: 2px solid forestgreen;
            background: #f8ffff;
            /* color: #69b8bd; */
            color: forestgreen;
            font-size: 16px;
            font-weight: 700;
            padding: 0 20px;
        }

            .inspection-upload-btn:hover {
                background: #eefbfc;
                color: darkgreen;
                border-color: darkgreen;
            }

        .inspection-file-list {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .inspection-file-chip {
            display: flex;
            align-items: center;
            min-width: 320px;
            max-width: 460px;
            height: 48px;
            border: 1px solid #d7e0e3;
            border-radius: 8px;
            background: #fff;
            overflow: hidden;
        }

        .inspection-file-icon {
            width: 44px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eef6f7;
            font-size: 20px;
            flex-shrink: 0;
        }

        .inspection-file-name {
            flex: 1;
            padding: 0 12px;
            font-size: 15px;
            color: #6aaeb5;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .inspection-file-remove {
            width: 40px;
            height: 48px;
            border: 0;
            background: transparent;
            color: #87b9be;
            font-size: 24px;
            line-height: 1;
            cursor: pointer;
            flex-shrink: 0;
        }

            .inspection-file-remove:hover {
                color: #4d8d93;
            }

        @@media (max-width: 992px) {
            .inspection-question-title {
                font-size: 16px;
            }

            .inspection-file-chip {
                min-width: 100%;
                max-width: 100%;
            }
        }

        .inspection-group {
            width: 100%;
        }

        .inspection-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin-bottom: 1px;
            white-space: normal;
        }

        .check-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin: 0;
            white-space: normal;
            font-weight: normal;
        }

            .check-item input[type="checkbox"] {
                margin: 0;
            }

        .date-input {
            width: 80px;
            display: inline-block;
        }

        .note-input {
            width: 240px;
            display: inline-block;
        }

        .rule-text {
            display: block;
            width: 100%;
            margin-bottom: 8px;
            line-height: 1.8;
            word-break: break-word;
            overflow-wrap: break-word;
            white-space: pre-line;
        }

        .pmds-radio-group {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

            .pmds-radio-group .radio-inline-item {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                margin-top: 6px;
                white-space: nowrap;
                font-weight: normal;
            }

                .pmds-radio-group .radio-inline-item input[type="radio"] {
                    margin: 0;
                }

        .btn-primary-line {
            height: 24px;
            padding: 1px 8px 0 8px;
            box-sizing: border-box;
        }

        .inspection-action-row {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 14px;
            margin-top: 16px;
        }

        .btn-form {
            margin: 0;
            font-size: 12pt;
            border: 2px solid #7ecb8a;
            background-color: #fff;
        }

            .btn-form:hover {
                border-color: #54a763;
                background-color: #f7fff8;
            }
    </style>
}


<h1 class="main-title">
    <span id="ctl00_ContentPlaceHolder1_UC_NodeName_lblNodeName">@ViewData["Title"]</span>
</h1>

<!-- 稽查題目區 -->
<div class="inspection-question-panel mt-4">
    @if (partialViewNames.Any())
    {
        foreach (var partialViewName in partialViewNames)
        {
            @await Html.PartialAsync(partialViewName)
        }
    }
    else if (hasInspectionId || shouldAlertNoInspectionItem)
    {
        if (hasInspectionId)
        {
            <div class="inspection-question-card">
                <div class="inspection-question-title">
                    查無對應表單
                </div>
                <div class="inspection-question-body">
                    <div class="rule-text">
                        查無此稽查項目對應的 Partial View。
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        //先不做任何動作
    }

</div>


@section Scripts {
    <script>
        @if (shouldAlertNoInspectionItem)
        {
            <text>
                alert('查無稽查項目');
                window.history.back();
            </text>
        }

        $(function () {
            // 1. 動態建立遮罩與彈窗
            var modalHtml = `
                <div id="attachFormMask" class="attach-form-mask" style="display:none;">
                    <div class="attach-form-dialog">
                        <div class="attach-form-header">附件表單單號</div>

                        <div class="attach-form-body">
                            <input type="text" id="attachFormNo" class="form-control" />
                        </div>

                        <div class="attach-form-footer">
                            <button type="button" id="btnAttachFormCancel" class="btn btn-success">取消</button>
                            <button type="button" id="btnAttachFormConfirm" class="btn btn-success">確定</button>
                        </div>
                    </div>
                </div>
            `;

            // 2. 動態加入遮罩樣式
            var modalStyle = `
                <style id="attachFormMaskStyle">
                    .attach-form-mask{
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        background: rgba(0, 0, 0, 0.35);
                        z-index: 9999;
                        display: none;
                    }

                    .attach-form-dialog{
                        position: absolute;
                        top: 50%;
                        left: 50%;
                        transform: translate(-50%, -50%);
                        width: 840px;
                        max-width: calc(100% - 30px);
                        background: #fff;
                        border: 1px solid #cfcfcf;
                        box-shadow: 0 6px 18px rgba(0,0,0,.2);
                    }

                    .attach-form-header{
                        background: #eef5ef;
                        color: #2ca24c;
                        font-size: 20px;
                        font-weight: 700;
                        padding: 12px 16px;
                        border-bottom: 1px solid #dcdcdc;
                    }

                    .attach-form-body{
                        padding: 22px 14px 28px 14px;
                        min-height: 100px;
                    }

                    .attach-form-body input.form-control{
                        height: 40px;
                        font-size: 16px;
                    }

                    .attach-form-footer{
                        border-top: 1px solid #e5e5e5;
                        padding: 14px 16px;
                        display: flex;
                        justify-content: flex-end;
                        gap: 10px;
                    }

                    .attach-form-footer .btn{
                        min-width: 70px;
                    }
                </style>
            `;

            if ($('#attachFormMask').length === 0) {
                $('body').append(modalHtml);
            }

            if ($('#attachFormMaskStyle').length === 0) {
                $('head').append(modalStyle);
            }

            // 3. 綁定「載入附件表單」按鈕
            $(document).on('click', 'input[type="button"][value="載入附件表單"]', function () {
                $('#attachFormMask').fadeIn(150);
                $('#attachFormNo').focus();
            });

            // 4. 關閉遮罩
            $(document).on('click', '#btnAttachFormCancel', function () {
                $('#attachFormMask').fadeOut(150);
            });

            // 5. 按確定
            $(document).on('click', '#btnAttachFormConfirm', function () {
                var attachFormNo = $.trim($('#attachFormNo').val());

                if (attachFormNo === '') {
                    alert('請輸入附件表單單號');
                    $('#attachFormNo').focus();
                    return;
                }

                // 這裡先示範：可先確認輸入值
                console.log('附件表單單號：' + attachFormNo);

                // 你後續若要帶去 API / Ajax / 指定欄位，可接在這裡
                $('#attachFormMask').fadeOut(150);
            });

            // 6. 點遮罩背景可關閉
            $(document).on('click', '#attachFormMask', function (e) {
                if (e.target.id === 'attachFormMask') {
                    $('#attachFormMask').fadeOut(150);
                }
            });

            // 7. Esc 關閉
            $(document).on('keydown', function (e) {
                if (e.key === 'Escape') {
                    $('#attachFormMask').fadeOut(150);
                }
            });
        });
    </script>
}
