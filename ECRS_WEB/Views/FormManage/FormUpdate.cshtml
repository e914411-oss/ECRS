        //     // 暫時先讓設定視窗內的取消按鈕關閉遮罩
        //     $("#cancelInsert").on("click", function (e) {
        //         e.preventDefault();
        //         $("#questionEditModal").hide();
        //     });

        // });


        function pad2(n) {
            return n.toString().padStart(2, "0");
        }

        // 西元日期轉民國日期：2026-04-01 => 115/04/01
        function adDateToRocDate(adDate) {
            if (!adDate) return "";

            var parts = adDate.replaceAll("/", "-").split("-");
            if (parts.length !== 3) return "";

            var year = parseInt(parts[0], 10);
            var month = parseInt(parts[1], 10);
            var day = parseInt(parts[2], 10);

            if (isNaN(year) || isNaN(month) || isNaN(day)) return "";

            return (year - 1911) + "/" + pad2(month) + "/" + pad2(day);
        }

        // 民國日期轉西元日期：115/04/01 => 2026-04-01
        function rocDateToAdDate(rocDate) {
            if (!rocDate) return "";

            var value = rocDate.trim().replaceAll("-", "/");
            var parts = value.split("/");

            if (parts.length !== 3) {
                return null;
            }

            var year = parseInt(parts[0], 10);
            var month = parseInt(parts[1], 10);
            var day = parseInt(parts[2], 10);

            if (isNaN(year) || isNaN(month) || isNaN(day)) {
                return null;
            }

            // 民國年轉西元年
            if (year < 1911) {
                year = year + 1911;
            }

            var checkDate = new Date(year, month - 1, day);

            if (
                checkDate.getFullYear() !== year ||
                checkDate.getMonth() !== month - 1 ||
                checkDate.getDate() !== day
            ) {
                return null;
            }

            return year + "-" + pad2(month) + "-" + pad2(day);
        }

        function setLoadingBlock(isActive) {
            var loadingBlock = document.getElementById("loadingBlock");
            var loadingMessage = document.getElementById("loadingMessage");

            if (loadingMessage) {
                loadingMessage.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>儲存中';
            }

            loadingBlock.classList.toggle("d-none", !isActive);
        }

        function getFormUpdateInputValues() {
            var projectId = $.trim($("#newFormId").val());
            var formName = $.trim($("#FormName").val());
            var projectDeadline = $.trim($("#ProjectDeadline").val());
            var originalProjectDeadline = $.trim($("#originalProjectDeadline").val());

            if (projectDeadline === "") {
                projectDeadline = originalProjectDeadline;
                $("#ProjectDeadline").val(projectDeadline);
            }

            var inspectionItems = $(".check-row input[type='checkbox']:checked").map(function () {
                return $(this).closest("label").find("span").first().text().trim();
            }).get().join(",");

            var inspectionItemsvalue = $(".check-row input[type='checkbox']:checked").map(function () {
                return $(this).val();
            }).get().join(",");

            var setStatus = $("input[name='IsSetStatus']:checked").val();

            var isValid = true;
            if (projectId === "" || formName === "" || projectDeadline === "") {
                isValid = false;
            }

            if (inspectionItems === "" || inspectionItemsvalue === "") {
                isValid = false;
            }

            if (!isValid) {
                return null;
            }

            return {
                projectId: projectId,
                formName: formName,
                projectDeadline: projectDeadline,
                status: setStatus,
                inspectionItems: inspectionItems,
                inspectionItemsvalue: inspectionItemsvalue
            };
        }

        function CheckData() {
            setLoadingBlock(true);

            var formData = getFormUpdateInputValues();
            if (formData == null) {
                alert("請填寫必填項目");
                setLoadingBlock(false);
                return false;
            }

            $.ajax({
                url: "@Url.Content("~/FormManage/FormUpdate")",
                type: "POST",
                dataType: "json",
                data: {
                    ProjectId: formData.projectId,
                    FormName: formData.formName,
                    ProjectDeadline: formData.projectDeadline,
                    Status: formData.status,
                    InspectionItems: formData.inspectionItems,
                    InspectionItemsValue: formData.inspectionItemsvalue
                },
                success: function (response) {
                    console.log("FormUpdate API 回傳：", response);

                    if (response && response.success === true) {
                        window.location.href = "@Url.Action("FormEditer", "FormManage")";
                    } else {
                        setLoadingBlock(false);
                        alert(response.message || "儲存失敗");
                    }
                },
                error: function (xhr, status, error) {
                    setLoadingBlock(false);
                    console.log("FormUpdate error xhr：", xhr);

                    var msg = "儲存失敗";

                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        msg = xhr.responseText;
                    }

                    alert(msg + "\n" + status + "\n" + error);
                }
            });

            return false;
        }

        //編輯浮動欄位設定
        function Savefloatcolumn() {
            var sort = $.trim($("#selectItemSort").val());
            var title = $.trim($("#selectItemColumnName").val());
            var type = $("input[name='ReportedType']:checked").val() || "";
            var ismust = $("input[name='ReportedRequired']:checked").val() || "";
            var note = $.trim($("#selectItemNote").val());

            var newinspectionid = $("#newFormId").val();

            var validateresult = true;

            if (sort === "") {
                validateresult = false;
            }

            if (title === "") {
                validateresult = false;
            }

            if (type === "") {
                validateresult = false;
            }

            if (ismust === "") {
                validateresult = false;
            }

            if (!validateresult) {
                alert("請填寫必填項目");
                return false;
            }

            if (newinspectionid === "") {
                alert("判斷目前尚未新增此專案，請先確定是否已新增過再編輯浮動欄位");
                return false;
            }

            var columndata = {
                newinspectionid: newinspectionid,
                sort: sort,
                title: title,
                note: note,
                type: type,
                ismust: ismust
            };

            return Savefloatcolumndata(columndata);
        }

        function Savefloatcolumndata(_columndata)
        {
            $.ajax({
                url: "@Url.Content("~/FormManage/FormAddFloatColumn")",
                type: "POST",
                dataType: "json",
                data: {
                    專案名稱代碼主鍵: _columndata.newinspectionid,
                    Sort: _columndata.sort,
                    ColumnName: _columndata.title,
                    Note: _columndata.note,
                    Type: _columndata.type,
                    IsmustTobe: _columndata.ismust
                },
                success: function (response) {
                    document.getElementById("loadingBlock").classList.add("d-none");
                    console.log("FormAddFloatColumn API 回傳：", response);

                    if (response && response.success === true) {
                        //alert("儲存成功，新增主鍵為：" + response.id);
                        // $("#newFormId").val(response.id);   //把新增的專案ID暫存
                        // var newId = response.id;
                        // console.log("新增資料主鍵：", newId);
                        alert(response.message);
                    } else {
                        alert(response.message || "浮動欄位設定失敗");
                    }
                },
                error: function (xhr, status, error) {
                    document.getElementById("loadingBlock").classList.add("d-none");

                    console.log("FormAddFloatColumn error xhr：", xhr);

                    var msg = "儲存失敗";

                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        msg = xhr.responseText;
                    }

                    alert(msg + "\n" + status + "\n" + error);
                }
            });

            return false;
        }

        // 點擊小日曆按鈕，打開對應的 type=date
        $(document).on("click", ".date-calendar-btn", function () {
            var pickerSelector = $(this).data("picker");
            var picker = document.querySelector(pickerSelector);

            if (!picker) return;

            if (picker.showPicker) {
                picker.showPicker();
            } else {
                picker.click();
            }
        });

        // 選完西元日期後，自動轉成民國年顯示到 textbox
        $(document).on("change", ".date-picker-hidden", function () {
            var adDate = $(this).val();
            var targetSelector = $(this).data("target");

            $(targetSelector).val(adDateToRocDate(adDate));
        });

        // 使用者手動輸入民國日期後，自動同步到隱藏的西元日期欄位
        $(document).on("blur", ".roc-date-text", function () {
            var textBoxId = "#" + $(this).attr("id");
            var rocDate = $(this).val();

            if (!rocDate) {
                if (textBoxId === "#ProjectDeadline") {
                    $("#ProjectDeadlineAd").val("");
                }

                return;
            }

            var adDate = rocDateToAdDate(rocDate);

            if (adDate === null) {
                alert("日期格式錯誤，請輸入民國年格式，例如：115/04/01");
                $(this).focus();
                return;
            }

            $(this).val(adDateToRocDate(adDate));

            if (textBoxId === "#ProjectDeadlineAd") {
                $("#ProjectDeadlineAd").val(adDate);
            }
        });



        document.addEventListener("DOMContentLoaded", function() {
            // --- 全域變數：用來記錄目前正在編輯哪一列 (null 代表是新增模式) ---
            let currentEditingRow = null;

            // 共用的垃圾桶 SVG 圖示
            const trashSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#389745" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/></svg>`;

            // 共用的表格動作按鈕 HTML
            const actionBtnsHtml = `
                <button type="button" class="btn btn-link p-0 me-2 text-success edit-question" title="編輯">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
                </button>
                <button type="button" class="btn btn-link p-0 text-success delete-question" title="刪除">${trashSvg}</button>
            `;

            // 初始化/重置彈窗的函式
            function resetModal() {
                document.getElementById('modalInputQNum').value = '';
                document.getElementById('modalInputTitle').value = '';
                document.getElementById('catAnswer').checked = true;
                document.getElementById('typeMulti').checked = true;
                document.getElementById('optionsContainer').innerHTML = `
                    <div class="option-item d-flex align-items-center mb-3 pb-2 border-bottom">
                        <input type="text" class="form-control me-3" style="flex: 1;">
                        <div class="form-check me-3 mb-0">
                            <input class="form-check-input" type="checkbox">
                            <label class="form-check-label text-nowrap">開放填寫說明</label>
                        </div>
                        <button type="button" class="btn btn-link p-0 delete-option">${trashSvg}</button>
                    </div>`;
                updateVisibility();
            }

            // 控制彈窗內顯示/隱藏的函式
            function updateVisibility() {
                const answerTypeRow = document.getElementById('answerTypeRow');
                const optionsRow = document.getElementById('optionsRow');
                const optionsLabel = document.getElementById('optionsLabel');
                const catChecked = document.querySelector('input[name="questionCategory"]:checked');
                const typeChecked = document.querySelector('input[name="answerType"]:checked');

                if (!catChecked || !answerTypeRow || !optionsRow) return;

                if (catChecked.value === 'desc') {
                    answerTypeRow.style.display = 'none';
                    optionsRow.style.display = 'none';
                } else {
                    answerTypeRow.style.display = 'table-row';
                    if (typeChecked && typeChecked.value === 'text') {
                        optionsRow.style.display = 'none';
                    } else if (typeChecked) {
                        optionsRow.style.display = 'table-row';
                        if (optionsLabel) optionsLabel.textContent = typeChecked.value === 'multi' ? '複選清單' : '單選清單';
                    }
                }
            }

            updateVisibility();

            // --- 1. 點擊「設定」按鈕 (新增模式) ---
            var btnSetItem = document.getElementById("btnSetItem");
            if(btnSetItem) {
                btnSetItem.addEventListener("click", function() {
                    currentEditingRow = null; // 確保是新增模式
                    resetModal(); // 清空舊資料
                    var modalEl = document.getElementById('questionEditModal');
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                });
            }

            // --- 2. 監聽 Change 事件 ---
            document.body.addEventListener('change', function(e) {
                if (e.target.name === 'IsSelfSet') {
                    const listContainer = document.getElementById('questionListContainer');
                    const listBody = document.getElementById('questionListBody');
                    if (e.target.value === 'Y') {
                        if(btnSetItem) btnSetItem.disabled = false;
                        if(listContainer && listBody && listBody.children.length > 0) listContainer.style.display = 'block';
                    } else {
                        if(btnSetItem) btnSetItem.disabled = true;
                        if(listContainer) listContainer.style.display = 'none';
                    }
                }
                if (e.target.name === 'questionCategory' || e.target.name === 'answerType') updateVisibility();
            });

            // --- 3. 監聽 Click 事件 (各種點擊動作) ---
            document.body.addEventListener('click', function(e) {

                // A. 彈窗內：新增選項
                if (e.target.closest('#btnAddOption')) {
                    const newOptionHtml = `
                        <div class="option-item d-flex align-items-center mb-3 pb-2 border-bottom">
                            <input type="text" class="form-control me-3" style="flex: 1;">
                            <div class="form-check me-3 mb-0">
                                <input class="form-check-input" type="checkbox">
                                <label class="form-check-label text-nowrap">開放填寫說明</label>
                            </div>
                            <button type="button" class="btn btn-link p-0 delete-option">${trashSvg}</button>
                        </div>`;
                    document.getElementById('optionsContainer').insertAdjacentHTML('beforeend', newOptionHtml);
                }

                // B. 彈窗內：刪除單一選項
                if (e.target.closest('.delete-option')) {
                    const optionsContainer = document.getElementById('optionsContainer');
                    if (optionsContainer.querySelectorAll('.option-item').length > 1) {
                        e.target.closest('.option-item').remove();
                    } else {
                        alert('請至少保留一個選項。');
                    }
                }

                // C. 主畫面：刪除整列題目
                if (e.target.closest('.delete-question')) {
                    if(confirm('確定要刪除此題目嗎？')) {
                        e.target.closest('tr').remove();
                        const listBody = document.getElementById('questionListBody');
                        if (listBody && listBody.children.length === 0) document.getElementById('questionListContainer').style.display = 'none';
                    }
                }

                // D. 主畫面：點擊「編輯」按鈕 (重點新增！)
                if (e.target.closest('.edit-question')) {
                    const tr = e.target.closest('tr');
                    currentEditingRow = tr; // 紀錄目前正在編輯這一列

                    // 抓取該列資料
                    const qNum = tr.children[0].textContent.replace('*', '').trim();
                    const qTitle = tr.children[1].textContent.trim();
                    const qCatText = tr.children[2].textContent.trim();
                    const contentTd = tr.children[3]; // 放題型的格子

                    // 填回彈窗輸入框
                    document.getElementById('modalInputQNum').value = qNum;
                    document.getElementById('modalInputTitle').value = qTitle;

                    // 判斷並還原選項按鈕
                    if (qCatText === '段落說明') {
                        document.getElementById('catDesc').checked = true;
                    } else {
                        document.getElementById('catAnswer').checked = true;
                        // 檢查內容區塊有什麼標籤來判斷題型
                        if (contentTd.querySelector('input[type="text"]')) {
                            document.getElementById('typeText').checked = true;
                        } else if (contentTd.querySelector('input[type="radio"]')) {
                            document.getElementById('typeSingle').checked = true;
                        } else if (contentTd.querySelector('input[type="checkbox"]')) {
                            document.getElementById('typeMulti').checked = true;
                        }

                        // 如果是單/複選，抓出裡面的 label 內容重建選項清單
                        if (contentTd.querySelector('input[type="radio"]') || contentTd.querySelector('input[type="checkbox"]')) {
                            const labels = contentTd.querySelectorAll('.form-check-label');
                            let optionsHtml = '';
                            labels.forEach(label => {
                                optionsHtml += `
                                    <div class="option-item d-flex align-items-center mb-3 pb-2 border-bottom">
                                        <input type="text" class="form-control me-3" style="flex: 1;" value="${label.textContent.trim()}">
                                        <div class="form-check me-3 mb-0">
                                            <input class="form-check-input" type="checkbox">
                                            <label class="form-check-label text-nowrap">開放填寫說明</label>
                                        </div>
                                        <button type="button" class="btn btn-link p-0 delete-option">${trashSvg}</button>
                                    </div>`;
                            });
                            document.getElementById('optionsContainer').innerHTML = optionsHtml;
                        }
                    }

                    updateVisibility(); // 更新顯示狀態
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('questionEditModal')).show(); // 開啟彈窗
                }

                // E. 彈窗：按下「確定」按鈕
                if (e.target.closest('#btnConfirmModal')) {
                    const qNum = document.getElementById('modalInputQNum').value.trim();
                    const qTitle = document.getElementById('modalInputTitle').value.trim();

                    if (!qTitle) {
                        alert("請輸入題目內容！");
                        return;
                    }

                    const qCategory = document.querySelector('input[name="questionCategory"]:checked').value;
                    const qCategoryText = (qCategory === 'answer') ? '回答問題' : '段落說明';
                    const ansTypeNode = document.querySelector('input[name="answerType"]:checked');
                    const ansType = ansTypeNode ? ansTypeNode.value : 'text';

                    // 生成「題目內容」欄位的 HTML
                    let displayContentHtml = '';
                    if (qCategory === 'answer') {
                        if (ansType === 'text') {
                            displayContentHtml = '<input type="text" class="form-control form-control-sm">';
                        } else {
                            const inputType = ansType === 'single' ? 'radio' : 'checkbox';
                            const uniqueName = "group_" + Date.now();
                            const optionInputs = document.querySelectorAll('#optionsContainer .option-item input[type="text"]');

                            let optionsHtml = '<div class="d-flex align-items-center flex-wrap">';
                            optionInputs.forEach(opt => {
                                if(opt.value.trim() !== '') {
                                    optionsHtml += `
                                        <div class="form-check form-check-inline mb-0 me-2">
                                            <input class="form-check-input" type="${inputType}" name="${uniqueName}">
                                            <label class="form-check-label">${opt.value}</label>
                                        </div>`;
                                }
                            });
                            optionsHtml += '</div>';
                            displayContentHtml = optionsHtml;
                        }
                    } else {
                        displayContentHtml = '<textarea class="form-control form-control-sm" rows="2" placeholder="請輸入說明內容..."></textarea>';
                    }

                    // 組合內部 <td> 的內容
                    const innerTdHtml = `
                        <td class="text-danger">*${qNum}</td>
                        <td class="text-start">${qTitle}</td>
                        <td>${qCategoryText}</td>
                        <td>${displayContentHtml}</td>
                        <td>${actionBtnsHtml}</td>
                    `;

                    // 判斷是「更新」還是「新增」
                    if (currentEditingRow) {
                        // 更新模式：直接替換該列的內容
                        currentEditingRow.innerHTML = innerTdHtml;
                        currentEditingRow = null; // 解除編輯狀態
                    } else {
                        // 新增模式：產生新的 <tr> 插入表格
                        const newRowHtml = `<tr>${innerTdHtml}</tr>`;
                        document.getElementById('questionListBody').insertAdjacentHTML('beforeend', newRowHtml);
                        document.getElementById('questionListContainer').style.display = 'block';
                    }

                    // 關閉並重置彈窗
                    bootstrap.Modal.getInstance(document.getElementById('questionEditModal')).hide();
                    resetModal();
                }
            });
        });

    </script>
}

