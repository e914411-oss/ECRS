@section Scripts {
    <script>
        const selectedInspectionItemValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedInspectionItemValues));

        document.addEventListener("DOMContentLoaded", function () {
            selectedInspectionItemValues.forEach(function (item) {
                const normalizedItem = String(item || "").trim();
                if (!normalizedItem) {
                    return;
                }

                document.querySelectorAll(".check-row input[type='checkbox']").forEach(function (checkbox) {
                    const labelText = checkbox.closest("label")?.querySelector("span")?.textContent.trim() || "";
                    if (checkbox.value === normalizedItem || labelText === normalizedItem) {
                        checkbox.checked = true;
                    }
                });
            });
        });

        $(function(){
            $("#save").on("click", function (e) {
                e.preventDefault();
                CheckData();
            });

        });
        // $(function () {

        //     // 開啟「編輯浮動欄位設定」遮罩
        //     $("#btnSetItem").on("click", function (e) {
        //         e.preventDefault();
        //         e.stopPropagation();

        //         var isSelfSet = $("input[name='IsSelfSet']:checked").val();
        //         if (isSelfSet !== "Y") {
        //             return false;
        //         }

        //         $("#questionEditModal").css("display", "flex");
        //     });

        //     // 點擊遮罩背景關閉
        //     $("#questionEditModal").on("click", function (e) {
        //         if (e.target === this) {
        //             $("#questionEditModal").hide();
        //         }
        //     });

        //     $("#save").on("click", function (e) {
        //         e.preventDefault();
        //         CheckData();
