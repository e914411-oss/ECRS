@model IEnumerable<ECRS_WEB.DTOs.FormManageDTO.FormEditer.AddProject_Result>
@using Microsoft.AspNetCore.Http

@{
    int ii = 1;
    var currentInspectionId = Context.Session.GetString("InspectionId") ?? string.Empty;
}

@if (Model == null)
{

}
else
{
    @foreach (var item in Model)
    {
        var canOperate = string.Equals(
            currentInspectionId,
            item.建立人員主鍵 ?? string.Empty,
            StringComparison.Ordinal) && !item.已產生稽查事件;

        <tr>
            <td class="lt">@ii</td>
            <td class="lt">@item.專案名稱</td>
            <td class="lt">
                @* <a class="nav-link text-black ajax-link" asp-controller="Inspection" asp-action="Flist" asp-route-companyId="@item.稽查項目">@item.稽查項目</a> *@
                @item.稽查項目
            </td>
            <td class="lt">@item.修改日期</td>
            <td class="lt">@item.異動人員</td>
            <td class="lt">@item.狀態</td>
            <td class="lt text-nowrap action-cell">
                <div class="d-flex flex-nowrap justify-content-center align-items-center gap-2">
                    <button type="button"
                            class="btn btn-move-datatable pb-1 js-project-action"
                            data-action="navigate"
                            data-project-id="@item.專案主鍵"
                            data-url="@(Url.Action("FormPreview", "FormManage") + "?projectId=" + QueryStringSecurityHelper.UrlEncode(item.專案主鍵))"
                            disabled="@(!canOperate)">
                        預覽
                    </button>
                    <button type="button"
                            class="btn btn-move-datatable pb-1 js-project-action"
                            data-action="navigate"
                            data-project-id="@item.專案主鍵"
                            data-url="@(Url.Action("FormUpdate", "FormManage") + "?projectId=" + QueryStringSecurityHelper.UrlEncode(item.專案主鍵))"
                            disabled="@(!canOperate)">
                        修改
                    </button>
                    <button type="button"
                            class="btn btn-move-datatable pb-1 js-project-action"
                            data-action="delete"
                            data-project-id="@item.專案主鍵"
                            disabled="@(!canOperate)">
                        刪除
                    </button>
                </div>
            </td>
        </tr>
        ii++;
    }

}

