@model IEnumerable<ECRS_WEB.DTOs.FormManageDTO.FormEditer.AddProject_Result>

@{
    int ii = 1;
}

@if (Model == null)
{

}
else
{
    @foreach (var item in Model)
    {
        <tr>
            <td class="lt">@ii</td>
            <td class="lt">@item.專案名稱</td>
            <td class="lt">
                @* <a class="nav-link text-black ajax-link" asp-controller="Inspection" asp-action="Flist" asp-route-companyId="@item.稽查項目">@item.稽查項目</a> *@
                @item.稽查項目
            </td>
            <td class="lt">@item.修改日期</td>
            <td class="lt">@item.異動人員</td>
            <td class="lt">@item.狀態</td>
            <td class="lt text-nowrap action-cell">
                <div class="d-flex flex-nowrap justify-content-center align-items-center gap-2">
                    <a class="btn btn-move-datatable pb-1" asp-controller="FormManage" asp-action="FormPreview" asp-route-projectId="@item.專案主鍵">預覽</a>
                    <a class="btn btn-move-datatable pb-1" asp-controller="FormManage" asp-action="FormUpdate" asp-route-projectId="@item.專案主鍵">修改</a>
                    <a class="btn btn-move-datatable pb-1" asp-controller="FormManage" asp-action="FormDelete" asp-route-projectId="@item.專案主鍵">刪除</a>
                </div>
            </td>
        </tr>
        ii++;
    }

}

