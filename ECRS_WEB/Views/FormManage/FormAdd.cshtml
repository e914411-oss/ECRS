@{
    ViewData["Title"] = "新增/編輯表單";
    string? formName = ViewData["FormName"] as string;
    string strFormName = string.IsNullOrEmpty(formName) ? string.Empty : formName;

    @Html.AntiForgeryToken()
    ;
}
@section Styles {
    <style>
        .form-editer-page {
            padding-bottom: 24px;
        }

        .form-editer-card {
            border: 2px solid #7ecb8a;
            border-radius: 8px;
            background: #f7fbf7;
            padding: 28px 18px 24px 18px;
            box-shadow: 0 0 0 4px rgba(126, 203, 138, .15);
            position: relative;
            padding-bottom: 20px;
        }

        .form-editer-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px 28px;
        }

        .form-editer-col {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .form-editer-col2 {
            display: flex;
            flex-direction: column;
            gap: 18px;
            grid-column: 1 / -1;
        }

        .query-row {
            display: grid;
            /* grid-template-columns: 120px minmax(256px, 1fr); */
            grid-template-columns: auto 1fr;
            align-items: center;
            gap: 8px;
        }

            .query-row.query-row-status {
                align-items: flex-start;
            }

        .query-label {
            margin: 0;
            font-size: 16px;
            color: #333;
            white-space: nowrap;
            justify-self: flex-start;
        }

        .query-inline {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .query-inline > .form-control,
            .query-inline > .form-select {
                flex: 1 1 auto;
            }

        .date-range-row {
            display: grid;
            grid-template-columns: 180px minmax(220px, 1fr) 180px minmax(220px, 1fr);
            align-items: center;
            gap: 12px 16px;
        }

        .date-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

            .date-input-wrap .form-control {
                padding-right: 42px;
            }

            .date-input-wrap .date-icon {
                position: absolute;
                right: 12px;
                color: #4caf50;
                pointer-events: none;
                font-size: 16px;
            }

        .radio-inline-item {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin: 0;
            white-space: normal;
            font-weight: normal;
        }

        .check-row {
            display: grid;
            grid-template-columns: repeat(4, minmax(256px, 1fr));
            gap: 12px 16px;
        }

        .check-row2 {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 4px 8px;
            flex-wrap: nowrap;
            width: 100%;
        }

            .check-row2 > label {
                margin-bottom: 0;
                white-space: nowrap;
            }

            .check-row2 > .radio-inline-item {
                flex: 0 0 auto;
            }

            .check-row2 > #btnSetItem {
                flex: 0 0 auto;
                white-space: nowrap;
            }

        .self-set-row,
        .status-row {
            min-height: 28px;
        }


        .check-row3 {
            width: 100%;
            display: grid;
            grid-template-columns: auto auto auto;
            align-items: center;
            gap: 4px 8px;
            justify-content: center;
        }

        .btn-group {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 16px;
        }

        .pmds-radio-group {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin: 0;
            white-space: nowrap;
            font-weight: normal;
        }

            .pmds-radio-group .radio-inline-item input[type="radio"] {
                margin: 0;
            }

        .sub-search-block {
            grid-column: 1 / -1;
            position: relative;
            margin-top: 0;
            padding-top: 0;
            padding-bottom: 46px;
        }

        .sub-search-card {
            border: 1px solid #7ecb8a;
            border-radius: 6px;
            background: #f7fbf7;
            padding: 16px 20px 22px 20px;
            box-shadow: inset 0 0 0 1px rgba(126, 203, 138, .12);
        }

        .sub-search-inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px 36px;
            align-items: start;
            min-height: 160px;
        }

        .sub-search-col {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .sub-search-row {
            display: grid;
            grid-template-columns: 220px minmax(220px, 1fr);
            align-items: center;
            gap: 10px;
        }

            .sub-search-row .query-label {
                text-align: left;
                justify-self: start;
            }

        .sub-search-toggle-wrap {
            position: static;
            margin-top: 12px;
            margin-bottom: 10px;
        }

        .sub-search-toggle {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            min-width: 122px;
            padding: 8px 14px;
            background: #f7fbf7;
            border: 1px solid #7ecb8a;
            border-radius: 4px;
            color: #5d6660;
            font-size: 14px;
            line-height: 1.2;
            box-shadow: none;
        }

            .sub-search-toggle:hover,
            .sub-search-toggle:focus {
                color: #333;
                background: #f7fbf7;
                border-color: #66b96e;
            }

            .sub-search-toggle .when-expanded {
                display: inline;
            }

            .sub-search-toggle .when-collapsed {
                display: none;
            }

            .sub-search-toggle.collapsed .when-expanded {
                display: none;
            }

            .sub-search-toggle.collapsed .when-collapsed {
                display: inline;
            }

            .sub-search-toggle .arrow-icon {
                display: inline-block;
                font-size: 12px;
                color: #777;
                transition: transform .2s ease;
            }

                .sub-search-toggle .arrow-icon::before {
                    content: "▲";
                }

            .sub-search-toggle.collapsed .arrow-icon::before {
                content: "▼";
            }

        .query-action-area {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 14px;
            margin: 30px 0 40px;
        }

        .table-title-row {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .btn-form {
            /* min-width: 160px; */
            margin: 0;
            font-size: 12pt;
            border: 2px solid #7ecb8a; /* 四周線條 */
            /* border-radius: 4px; /* 圓角，可留可拿掉 */
            background-color: #fff; /* 背景白色 */
            */
        }

        btn-form:hover {
            margin: 0;
            padding: 0;
            font-size: 12pt;
            border: 2px solid #7ecb8a; /* 四周線條 */
        }

        .btn-add-form {
            min-width:30px;
            margin: 0;
            padding: 0;
            font-size: 9pt;
            border: 2px solid #7ecb8a; /* 四周線條 */
            /* border-radius: 4px; /* 圓角，可留可拿掉 */
            background-color: #fff; /* 背景白色 */
            */
        }

            .btn-add-form:hover {
                border-color: #333;
                background-color: #f5f5f5;
                color: #000;
            }

        .query-summary {
            color: #1f9d46;
            font-size: 16px;
            margin-bottom: 10px;
        }

        .form-list-card {
            border: 1px solid #b9dfc1;
            border-radius: 10px;
            padding: 16px;
        }

        .form-list-wrap {
            overflow-x: auto;
        }

        table.dataTable.form-list-table thead th {
            background: #f1f3f5;
        }

        table.dataTable.form-list-table thead th {
            background: #cddccf;
            color: #222;
            font-size: 18px;
            font-weight: 700;
            text-align: center;
            padding: 14px 10px;
            border-bottom: 1px solid #b7c9b8 !important;
            white-space: nowrap;
        }

        table.dataTable.form-list-table tbody td {
            font-size: 16px;
            color: #222;
            text-align: center;
            vertical-align: middle;
            padding: 14px 12px;
            border-bottom: 1px solid #d8d8d8 !important;
            background: #fff;
        }

        table.dataTable.form-list-table tbody tr:last-child td {
            border-bottom: none !important;
        }

        .td-project-item,
        .td-project-name {
            text-align: left;
            line-height: 1.6;
        }

        .td-edit-date {
            line-height: 1.5;
            white-space: nowrap;
        }

        .status-text {
            color: #2d7a2d;
            font-weight: 500;
        }

        .action-stack {
            display: inline-flex;
            flex-direction: column;
            gap: 8px;
        }

            .action-stack .btn {
                min-width: 68px;
                border-radius: 4px;
            }

        .btn-outline-ecrs {
            color: #66b96e;
            border: 1px solid #7fc987;
            background: #fff;
        }

            .btn-outline-ecrs:hover {
                color: #fff;
                background: #66b96e;
                border-color: #66b96e;
            }

        table.dataTable thead > tr > th.sorting,
        table.dataTable thead > tr > th.sorting_asc,
        table.dataTable thead > tr > th.sorting_desc,
        table.dataTable thead > tr > th.sorting_asc_disabled,
        table.dataTable thead > tr > th.sorting_desc_disabled {
            padding-right: 10px !important;
            background-image: none !important;
        }

        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate,
        .dataTables_wrapper .dataTables_length {
            display: block !important;
        }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 10px;
        }

            .dataTables_wrapper .dataTables_length label,
            .dataTables_wrapper .dataTables_filter label {
                margin-bottom: 0;
                font-weight: 400;
            }

            .dataTables_wrapper .dataTables_length select,
            .dataTables_wrapper .dataTables_filter input {
                height: 38px;
                border: 1px solid #ced4da;
                border-radius: 4px;
                background: #fff;
                box-shadow: none;
            }

            .dataTables_wrapper .dataTables_length select {
                min-width: 80px;
                padding: 6px 30px 6px 10px;
                margin: 0 6px;
            }

            .dataTables_wrapper .dataTables_filter input {
                min-width: 180px;
                margin-left: 8px;
                padding: 6px 10px;
            }

        .dataTables_wrapper .dataTables_info {
            padding-top: 10px;
        }

        .dataTables_wrapper .dataTables_paginate {
            padding-top: 10px;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                min-width: 42px;
                padding: 8px 12px !important;
                margin-left: 0 !important;
                border: 1px solid #dee2e6 !important;
                background: #fff !important;
                color: #0d6efd !important;
                box-shadow: none !important;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                    background: #e9f3ff !important;
                    color: #0a58ca !important;
                }

                .dataTables_wrapper .dataTables_paginate .paginate_button.current,
                .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
                    background: #0d6efd !important;
                    color: #fff !important;
                    border-color: #0d6efd !important;
                }

                .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
                .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
                    color: #6c757d !important;
                    background: #fff !important;
                    border-color: #dee2e6 !important;
                    opacity: 1;
                }

        .grid-footer-wrap {
            margin-top: -2px;
            padding: 12px 14px;
            border: 2px solid #b9dfc1;
            border-top: none;
            border-radius: 0 0 10px 10px;
            background: #f7f7f7;
        }

        @@media (max-width: 992px) {
            .form-editer-grid {
                grid-template-columns: 1fr;
            }

            .date-range-row {
                grid-template-columns: 150px minmax(220px, 1fr);
            }

            .sub-search-inner {
                grid-template-columns: 1fr;
                min-height: auto;
            }

            .grid-footer-wrap .row {
                row-gap: 12px;
            }

            .dataTables_wrapper .dataTables_info,
            .dataTables_wrapper .dataTables_paginate {
                text-align: center;
            }
        }

        @@media (max-width: 576px) {
            .query-row,
            .sub-search-row,
            .date-range-row {
                grid-template-columns: 1fr;
                gap: 6px;
            }

            .query-label {
                white-space: normal;
            }

            .sub-search-block {
                padding-bottom: 46px;
            }

            .sub-search-toggle-wrap {
                left: 0;
                bottom: 0;
            }

            table.dataTable.form-list-table thead th,
            table.dataTable.form-list-table tbody td {
                font-size: 14px;
                padding: 10px 8px;
            }
        }

        .dataTables_paginate .pagination {
            width: 100%;
            justify-content: space-between;
        }

        .pmds-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .pmds-note-modal {
            width: min(980px, 92vw);
            height: min(620px, 82vh);
            background: #fff;
            border-radius: 4px;
            box-shadow: 0 10px 30px rgba(0,0,0,.25);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            border: 1px solid #ddd;
        }

        .pmds-note-header {
            padding: 14px 18px;
            background: #eaf6ea;
            border-bottom: 1px solid #cfe6cf;
        }

        .pmds-note-title {
            color: #1a8f2b;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .pmds-note-body {
            padding: 18px;
            flex: 1;
        }

        .pmds-note-textarea {
            width: 100%;
            height: 100%;
            resize: none;
            border: 2px solid #e0e0e0;
            border-radius: 4px;
            padding: 12px;
            font-size: 16px;
            outline: none;
        }

        .pmds-note-footer {
            padding: 14px 18px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            border-top: 1px solid #eee;
            background: #fff;
        }

        /* SetItemOverlay：編輯浮動欄位專用視窗 */
        .pmds-setitem-modal {
            width: min(960px, 94vw);
            max-height: 88vh;
            background: #fff;
            border-radius: 4px;
            box-shadow: 0 10px 30px rgba(0,0,0,.25);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            border: 1px solid #ddd;
        }

        .pmds-setitem-header {
            padding: 14px 18px;
            background: #eaf6ea;
            border-bottom: 1px solid #cfe6cf;
        }

        .pmds-setitem-title {
            color: #1a8f2b;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .pmds-setitem-body {
            padding: 18px;
            overflow-y: auto;
        }

        .pmds-setitem-card {
            border: 2px solid #e0e0e0;
            border-radius: 4px;
            padding: 26px 52px 24px 52px;
            background: #fff;
        }

        .setitem-row {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 12px;
        }

        .setitem-row-top {
            display: grid;
            grid-template-columns: auto 100px auto minmax(320px, 1fr);
            align-items: center;
            column-gap: 8px;
        }

        .setitem-label {
            margin: 0;
            font-size: 16px;
            color: #222;
            white-space: nowrap;
            font-weight: normal;
        }

        .setitem-required {
            color: red;
            padding-right: 3px;
        }

        .setitem-sort-input {
            width: 100px;
        }

        .setitem-title-input {
            width: 100%;
            max-width: 560px;
        }

        .setitem-desc-row {
            display: grid;
            grid-template-columns: auto minmax(320px, 1fr);
            align-items: flex-start;
            column-gap: 8px;
            margin-bottom: 12px;
        }

        .setitem-desc-textarea {
            width: 100%;
            max-width: 700px;
            min-height: 86px;
            resize: vertical;
            padding-left: -2px;
        }

        .setitem-radio-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            column-gap: 48px;
            align-items: center;
            max-width: 700px;
            margin-bottom: 14px;
        }

        .setitem-radio-block {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .setitem-radio-options {
            display: inline-flex;
            align-items: center;
            gap: 14px;
        }

            .setitem-radio-options .radio-inline {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                white-space: nowrap;
            }

        .setitem-button-row {
            display: flex;
            justify-content: flex-start;
            gap: 12px;
            margin-top: 8px;
        }

        .setitem-add-row {
            display: flex;
            justify-content: flex-end;
            margin-top: 12px;
        }

        @@media (max-width: 768px) {
            .pmds-setitem-card {
                padding: 18px;
            }

            .setitem-row-top,
            .setitem-desc-row,
            .setitem-radio-row {
                grid-template-columns: 1fr;
                row-gap: 8px;
            }

            .setitem-radio-row {
                max-width: none;
            }

            .setitem-radio-block {
                justify-content: flex-start;
            }
        }

        .date-range-row {
            display: grid;
            grid-template-columns: 180px minmax(220px, 1fr) 180px minmax(220px, 1fr);
            align-items: center;
            gap: 12px 16px;
            padding-bottom: 15px;
        }


        .date-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

            .date-input-wrap .roc-date-text {
                padding-right: 46px;
            }

            .date-input-wrap .date-picker-hidden {
                position: absolute;
                right: 0;
                top: 0;
                width: 42px;
                height: 100%;
                opacity: 0;
                z-index: 2;
                cursor: pointer;
            }

            .date-input-wrap .date-calendar-btn {
                position: absolute;
                right: 1px;
                top: 1px;
                width: 40px;
                height: calc(100% - 2px);
                border: 0;
                border-left: 1px solid #ced4da;
                background: #fff;
                color: #333;
                z-index: 1;
                cursor: pointer;
                border-radius: 0 0.375rem 0.375rem 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .date-input-wrap .date-calendar-btn:hover {
                    background: #f2f2f2;
                }

        .single-date-row {
            display: grid;
            grid-template-columns: auto 220px;
            align-items: center;
            column-gap: 8px;
            justify-content: start;
        }

            .single-date-row .date-input-wrap {
                width: 220px;
            }

        .date-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

            .date-input-wrap .roc-date-text {
                width: 100%;
                padding-right: 46px;
            }

            .date-input-wrap .date-picker-hidden {
                position: absolute;
                right: 0;
                top: 0;
                width: 42px;
                height: 100%;
                opacity: 0;
                z-index: 3;
                cursor: pointer;
            }

            .date-input-wrap .date-calendar-btn {
                position: absolute;
                right: 1px;
                top: 1px;
                width: 40px;
                height: calc(100% - 2px);
                border: 0;
                border-left: 1px solid #ced4da;
                background: #fff;
                color: #333;
                z-index: 2;
                cursor: pointer;
                border-radius: 0 0.375rem 0.375rem 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }
    </style>
}

<div class="content form-editer-page" style="min-height: 561px;">
    <h1 class="main-title">
        <span id="title">@ViewData["Title"]</span>
    </h1>

    <div class="form-editer-card">
        <div class="form-editer-grid">
            <div class="form-editer-col">
                <div class="query-row">
                    <label class="query-label"><span style="color: Red">＊</span>表單名稱：</label>
                    <input name="FormName" id="FormName" class="form-control" type="text" value=@strFormName>
                </div>
            </div>
            <div class="form-editer-col">
                <div class="single-date-row">
                    <label class="query-label"><span id="span_Testing_Weight" style="color: Red;"></span>專案截止日期：</label>
                    <div class="date-input-wrap">
                        <input name="ProjectDeadline" id="ProjectDeadline"
                               type="text"
                               class="form-control roc-date-text"
                               placeholder="例：115/04/01"
                               autocomplete="off">
                        <input id="ProjectDeadlineAd"
                               name="ProjectDeadlineAd"
                               type="date"
                               class="date-picker-hidden"
                               data-target="#ProjectDeadline" />
                        <button type="button"
                                class="date-calendar-btn"
                                data-picker="#ProjectDeadlineAd"
                                aria-label="選擇專案截止日期起">
                            <i class="bi bi-calendar3"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-5 mb-1">
        <h6 class="main-title">
            <span style="color: Red">＊</span>稽查項目：
        </h6>
    </div>

    <div class="form-editer-card mb-3">
        <div class="form-editer-grid">
            <div class="form-editer-col">
                <div class="check-row">
                    <label class="radio-inline-item pe-3">
                        <input id="ghp" type="checkbox" value="Y">
                        <span>GHP</span>
                        <a class="btn btn-add-form">備註</a>
                    </label>
                    <label class="radio-inline-item pe-3">
                        <input id="industryFoodRecord" type="checkbox" value="Y">
                        <span>食品業者登錄</span>
                        <a class="btn btn-add-form">備註</a>
                    </label>
                    <label class="radio-inline-item pe-3">
                        <input id="responsibility" type="checkbox" value="Y">
                        <span>產品責任險</span>
                        <a class="btn btn-add-form">備註</a>
                    </label>
                </div>
                <div class="check-row">
                    <label class="radio-inline-item pe-3">
                        <input id="HACCP" type="checkbox" value="Y">
                        <span>HACCP</span>
                        <a class="btn btn-add-form">備註</a>
                    </label>
                    <label class="radio-inline-item pe-3">
