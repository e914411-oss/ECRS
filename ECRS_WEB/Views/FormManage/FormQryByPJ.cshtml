@using ECRS_WEB.Models.PMDS
@{
    ViewData["Title"] = "表單管理-專案查詢";
    var departments = ViewBag.Departments as IEnumerable<系統_部門表> ?? Enumerable.Empty<系統_部門表>();
}

@section Styles {
    <style>
        .main-title {
            position: relative;
            display: block;
            margin: 0 0 24px 0;
            padding-left: 16px;
            font-size: 24px;
            font-weight: 700;
            line-height: 1.5;
            color: #222;
        }

            .main-title::before {
                content: "";
                position: absolute;
                top: 50%;
                left: 0;
                width: 5px;
                height: 23px;
                background: #349f41;
                border-radius: 5px;
                transform: translateY(-50%);
            }

        .formqry-card {
            background: #fff;
            border: 1px solid #dfe7df;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }

        .query-grid {
            display: grid;
            grid-template-columns: 160px 1fr;
            gap: 12px 16px;
            align-items: center;
        }

            .query-grid .full-row {
                grid-column: 1 / -1;
            }

        .query-label {
            margin: 0;
            font-size: 16px;
            color: #333;
            white-space: nowrap;
        }

        .query-radio-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin: 0;
            font-size: 16px;
            color: #333;
        }

        .query-actions {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
        }

        .dual-list-section {
            margin-top: 28px;
        }

        .dual-list-header,
        .dual-list-body {
            display: grid;
            grid-template-columns: minmax(280px, 1fr) 90px minmax(280px, 1fr);
            gap: 20px;
            align-items: start;
        }

        .dual-list-header {
            margin-bottom: 10px;
        }

        .dual-list-title {
            font-size: 18px;
            font-weight: 700;
            text-align: center;
            color: #222;
        }

        .dual-list-box {
            min-height: 400px;
        }

            .dual-list-box select {
                width: 100%;
                min-height: 400px;
            }

        .dual-list-actions {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            min-height: 400px;
        }

        .btn-transfer {
            min-width: 72px;
        }

        .bottom-actions {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 28px;
        }

        @@media (max-width: 992px) {
            .dual-list-header,
            .dual-list-body {
                grid-template-columns: 1fr;
            }

            .dual-list-actions {
                min-height: auto;
                flex-direction: row;
                justify-content: center;
                padding: 10px 0;
            }
        }

        @@media (max-width: 576px) {
            .query-grid {
                grid-template-columns: 1fr;
            }

            .query-actions {
                justify-content: center;
            }
        }
    </style>
}

<h1 class="main-title">@ViewData["Title"]</h1>

<div id="ctl00_ContentPlaceHolder1_Panel1" class="formqry-card">
    <input type="hidden" name="ctl00$ContentPlaceHolder1$GroupId" id="ctl00_ContentPlaceHolder1_GroupId" value="4" />

    <div class="query-grid">
        <label for="FormName" class="query-radio-label">
            <input id="radioCustom" type="radio" name="groupType" />
            <span>自訂表單名稱：</span>
        </label>
        <input id="FormName" type="text" placeholder="請輸入自訂表單名稱..." class="form-control" />

        <label for="ProjectName" class="query-radio-label">
            <input id="radioProject" type="radio" name="groupType" checked />
            <span>專案名稱：</span>
        </label>
        <input id="ProjectName" type="text" class="form-control" placeholder="請輸入專案名稱..." />

        <label for="Select1" class="query-label">建立單位：</label>
        <div>
            <select id="Select1" class="form-select" style="max-width: 220px;">
                <option value="">全部</option>
                @foreach (var department in departments)
                {
                    <option value="@department.部門編號">@department.名稱</option>
                }
            </select>
        </div>
    </div>

    <div class="query-actions">
        <button type="button" id="btnSearch" class="btn btn-success px-4">搜尋</button>
        <input id="btnClear" type="button" class="btn btn-success px-4" onclick="qry_clear()" value="清除" />
    </div>

    <div class="dual-list-section">
        <div class="dual-list-header">
            <div class="dual-list-title">搜尋結果</div>
            <div></div>
            <div class="dual-list-title">已選擇專案</div>
        </div>

        <div class="dual-list-body">
            <div class="dual-list-box">
                <select size="4"
                        name="ProjectResult"
                        multiple="multiple"
                        id="ProjectResult"
                        class="form-control">
                </select>
                <div id="searchStatus" class="form-text text-center mt-2">請輸入條件後按「搜尋」。</div>
            </div>

            <div class="dual-list-actions">
                <input type="button"
                       name="ctl00$ContentPlaceHolder1$right"
                       value="-&gt;"
                       id="ctl00_ContentPlaceHolder1_right"
                       class="btn btn-outline-primary btn-transfer" />

                <input type="button"
                       name="ctl00$ContentPlaceHolder1$left"
                       value="&lt;-"
                       id="ctl00_ContentPlaceHolder1_left"
                       class="btn btn-outline-primary btn-transfer" />
            </div>

            <div class="dual-list-box">
                <select size="4"
                        name="SelectedProject"
                        multiple="multiple"
                        id="SelectedProject"
                        class="form-control">
                </select>
            </div>
        </div>
    </div>

    <div class="bottom-actions">
        <button type="button"
                id="btnSaveProjects"
                class="btn btn-success">
            儲存
        </button>

        <button type="button" class="btn btn-secondary" onclick="window.history.go(-1);">取消</button>
    </div>

    <div id="formAddHost"></div>
</div>



@section Scripts {
    <script>
        function qry_clear() {
            $('#FormName').val('');
            $('#ProjectName').val('');
            $('#Select1').prop('selectedIndex', 0);
            $('#ProjectResult').empty();
            $('#searchStatus').text('請輸入條件後按「搜尋」。').removeClass('text-danger');
            $('#radioProject').prop('checked', true);
        }

        function buildQueryCondition() {
            var keyword = $('#radioCustom').is(':checked')
                ? $.trim($('#FormName').val())
                : $.trim($('#ProjectName').val());

            return {
                CreateDepartment: $('#Select1').val(),
                ProjectName: keyword,
                FormStatus: '',
                ProjectDeadlineStart: '',
                ProjectDeadlineEnd: ''
            };
        }

        var searchListSelector = '#ProjectResult';
        var selectedListSelector = '#SelectedProject';

        function getOptionValues($list) {
            return $list.find('option').map(function () {
                return this.value;
            }).get();
        }

        function hasOptionValue(values, value) {
            return values.indexOf(value) !== -1;
        }

        function addOptions($target, items, excludedValues) {
            var existingValues = getOptionValues($target);
            var excluded = excludedValues || [];
            var addedCount = 0;

            items.forEach(function (item) {
                if (hasOptionValue(existingValues, item.value) || hasOptionValue(excluded, item.value)) {
                    return;
                }

                $('<option/>', {
                    value: item.value,
                    text: item.text
                }).appendTo($target);

                existingValues.push(item.value);
                addedCount += 1;
            });

            return addedCount;
        }

        function updateSearchStatus() {
            var count = $(searchListSelector).find('option').length;
            $('#searchStatus').text('共查得 ' + count + ' 筆資料。').removeClass('text-danger');
        }

        function moveSelectedOptions(sourceSelector, targetSelector) {
            var $source = $(sourceSelector);
            var selectedItems = $source.find('option:selected').map(function () {
                return {
                    value: this.value,
                    text: this.text
                };
            }).get();

            if (selectedItems.length === 0) {
                alert('請先選擇要移動的項目。');
                return;
            }

            addOptions($(targetSelector), selectedItems);
            $source.find('option:selected').remove();

            if (sourceSelector === searchListSelector || targetSelector === searchListSelector) {
                updateSearchStatus();
            }
        }

        function getSelectedProjectIds() {
            return $(selectedListSelector).find('option').map(function () {
                return parseInt(this.value, 10);
            }).get().filter(function (value) {
                return !isNaN(value);
            });
        }

        $('#btnSaveProjects').on('click', function () {
            var projectIds = getSelectedProjectIds();

            if (projectIds.length === 0) {
                alert('請先選擇要儲存的專案。');
                return;
            }

            var $button = $(this);
            $button.prop('disabled', true);

            $.ajax({
                url: '@Url.Action("FormQryByPJSave", "FormManage")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ projectIds: projectIds }),
                success: function (result) {
                    alert(result && result.message ? result.message : '儲存成功');
                },
                error: function (xhr) {
                    var message = xhr.responseJSON && xhr.responseJSON.message
                        ? xhr.responseJSON.message
                        : '儲存失敗，請稍後再試。';
                    alert(message);
                },
                complete: function () {
                    $button.prop('disabled', false);
                }
            });
        });

        $('#btnSearch').on('click', function () {
            var $button = $(this);
            var $resultList = $('#ProjectResult');
            var $status = $('#searchStatus');

            $button.prop('disabled', true);
            $resultList.empty();
            $status.text('查詢中，請稍候...').removeClass('text-danger');

            $.ajax({
                url: '@Url.Action("FormQryByPJSearch", "FormManage")',
                type: 'GET',
                cache: false,
                data: buildQueryCondition(),
                success: function (items) {
                    if (!items || items.length === 0) {
                        $status.text('查無資料。');
                        return;
                    }

                    var selectedValues = getOptionValues($(selectedListSelector));
                    var addedCount = addOptions($resultList, items, selectedValues);
                    if (addedCount === 0) {
                        $status.text('查無資料。');
                        return;
                    }

                    $status.text('共查得 ' + addedCount + ' 筆資料。');
                },
                error: function (xhr) {
                    var message = xhr.responseJSON && xhr.responseJSON.message
                        ? xhr.responseJSON.message
                        : '查詢失敗，請稍後再試。';
                    $status.text(message).addClass('text-danger');
                },
                complete: function () {
                    $button.prop('disabled', false);
                }
            });
        });

        $('#ctl00_ContentPlaceHolder1_right').on('click', function () {
            moveSelectedOptions(searchListSelector, selectedListSelector);
        });

        $('#ctl00_ContentPlaceHolder1_left').on('click', function () {
            moveSelectedOptions(selectedListSelector, searchListSelector);
        });
    </script>
}
