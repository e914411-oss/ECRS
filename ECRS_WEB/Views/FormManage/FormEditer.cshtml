@model IEnumerable<ECRS_WEB.Models.ECRS.專案名稱代碼表>

@{
    ViewData["Title"] = "表單管理-表單編輯作業";
    var Departments = ViewBag.Departments ?? new List<ECRS_WEB.Models.PMDS.系統_部門表>();
}

@section Styles {
    <style>
        th {
            text-wrap: nowrap;
        }

        .main-title {
            font-size: 1.35rem;
            font-weight: 600;
            position: relative;
            padding-left: 12px;
        }

            .main-title::before {
                content: "";
                position: absolute;
                left: 0;
                top: 3px;
                width: 4px;
                height: 20px;
                background: #198754;
                border-radius: 2px;
            }

        .secend-title {
            font-size: 1.1rem;
            font-weight: 600;
            position: relative;
            padding-left: 10px;
        }

            .secend-title::before {
                content: "";
                position: absolute;
                left: 0;
                top: 3px;
                width: 3px;
                height: 16px;
                background: #198754;
                border-radius: 2px;
            }

        .form-editer-page {
            padding-bottom: 24px;
        }

        .form-editer-card {
            border: 2px solid #7ecb8a;
            border-radius: 8px;
            background: #f7fbf7;
            padding: 28px 18px 24px 18px;
            box-shadow: 0 0 0 4px rgba(126, 203, 138, .15);
            position: relative;
        }

        .form-editer-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px 28px;
        }

        .form-editer-col {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .query-row {
            display: grid;
            grid-template-columns: 150px minmax(220px, 1fr);
            align-items: center;
            gap: 10px;
        }

            .query-row.query-row-status {
                align-items: end;
            }

        .query-label {
            margin: 0;
            font-size: 16px;
            color: #333;
            white-space: nowrap;
            text-align: right;
            justify-self: end;
        }

        .query-inline {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .query-inline > .form-control,
            .query-inline > .form-select {
                flex: 1 1 auto;
            }

        .sub-search-section {
            grid-column: 1 / -1;
            margin-top: 6px;
        }

        .date-range-row {
            display: grid;
            grid-template-columns: 180px minmax(220px, 1fr) 180px minmax(220px, 1fr);
            align-items: center;
            gap: 12px 16px;
            padding-bottom: 15px;
        }


        .date-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

            .date-input-wrap .roc-date-text {
                padding-right: 46px;
            }

            .date-input-wrap .date-picker-hidden {
                position: absolute;
                right: 0;
                top: 0;
                width: 42px;
                height: 100%;
                opacity: 0;
                z-index: 2;
                cursor: pointer;
            }

            .date-input-wrap .date-calendar-btn {
                position: absolute;
                right: 1px;
                top: 1px;
                width: 40px;
                height: calc(100% - 2px);
                border: 0;
                border-left: 1px solid #ced4da;
                background: #fff;
                color: #333;
                z-index: 1;
                cursor: pointer;
                border-radius: 0 0.375rem 0.375rem 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .date-input-wrap .date-calendar-btn:hover {
                    background: #f2f2f2;
                }

        .pmds-radio-group {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

            .pmds-radio-group .radio-inline-item {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                margin: 0;
                white-space: nowrap;
                font-weight: normal;
            }

                .pmds-radio-group .radio-inline-item input[type="radio"] {
                    margin: 0;
                }

        .sub-search-block {
            grid-column: 1 / -1;
            position: relative;
            margin-top: 0;
            padding-top: 0;
            padding-bottom: 46px;
        }

        .sub-search-card {
            border: 1px solid #7ecb8a;
            border-radius: 6px;
            background: #f7fbf7;
            padding: 16px 20px 22px 20px;
            box-shadow: inset 0 0 0 1px rgba(126, 203, 138, .12);
        }

        .sub-search-inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px 36px;
            align-items: start;
            min-height: 160px;
        }

        .sub-search-col {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .sub-search-row {
            display: grid;
            grid-template-columns: 220px minmax(220px, 1fr);
            align-items: center;
            gap: 10px;
        }

            .sub-search-row .query-label {
                text-align: left;
                justify-self: start;
            }

        .sub-search-toggle-wrap {
            position: static;
            margin-top: 12px;
            margin-bottom: 10px;
        }

        .sub-search-toggle {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            min-width: 122px;
            padding: 8px 14px;
            background: #f7fbf7;
            border: 1px solid #7ecb8a;
            border-radius: 4px;
            color: #5d6660;
            font-size: 14px;
            line-height: 1.2;
            box-shadow: none;
        }

            .sub-search-toggle:hover,
            .sub-search-toggle:focus {
                color: #333;
                background: #f7fbf7;
                border-color: #66b96e;
            }

            .sub-search-toggle .when-expanded {
                display: inline;
            }

            .sub-search-toggle .when-collapsed {
                display: none;
            }

            .sub-search-toggle.collapsed .when-expanded {
                display: none;
            }

            .sub-search-toggle.collapsed .when-collapsed {
                display: inline;
            }

            .sub-search-toggle .arrow-icon {
                display: inline-block;
                font-size: 12px;
                color: #777;
                transition: transform .2s ease;
            }

                .sub-search-toggle .arrow-icon::before {
                    content: "▲";
                }

            .sub-search-toggle.collapsed .arrow-icon::before {
                content: "▼";
            }

        .query-action-area {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 14px;
            margin: 30px 0 40px;
        }

        .table-title-row {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .btn-add-form {
            min-width: 160px;
            border: 2px solid #7ecb8a; /* 四周線條 */
            /* border-radius: 4px; /* 圓角，可留可拿掉 */
            background-color: #fff; /* 背景白色 */
            */
        }

            .btn-add-form:hover {
                border-color: #333;
                background-color: #f5f5f5;
                color: #000;
            }

        .btn-move-datatable {
            min-width: 18px;
            border: 2px solid #7ecb8a; /* 四周線條 */
            border-radius: 4px; /* 圓角，可留可拿掉 */
            background-color: #fff; /* 背景白色 */
        }

            .btn-move-datatable:hover {
                border-color: #333;
                background-color: #f5f5f5;
                color: #000;
            }

        .action-cell {
            min-width: 190px;
            white-space: nowrap;
        }

            .action-cell .btn {
                white-space: nowrap;
            }

        .query-summary {
            color: #1f9d46;
            font-size: 16px;
            margin-bottom: 10px;
        }

        .form-list-card {
            /* border: 1px solid #b9dfc1;
            border-radius: 10px;
            padding: 16px; */
            border: 2px solid #b9dfc1;
            border-radius: 10px;
            overflow: auto;
            background: #fff;
        }

        .form-list-wrap {
            /* overflow-x: auto; */
            padding: 6px 10px 0 10px;
        }

        table.dataTable.form-list-table {
            /* background: #f1f3f5; */
            width: 100% !important;
            border-collapse: collapse !important;
            margin: 0 !important;
        }

        table.dataTable.form-list-table thead th {
            background: #cddccf;
            color: #222;
            font-size: 18px;
            font-weight: 700;
            text-align: center;
            padding: 14px 10px;
            border-bottom: 1px solid #b7c9b8 !important;
            white-space: nowrap;
        }

        table.dataTable.form-list-table tbody td {
            font-size: 16px;
            color: #222;
            text-align: center;
